APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Stored timestamps stay UTC; this is only what the dashboard and CSV render.
APP_DISPLAY_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Lokal: log. Produksi: SMTP Resend (tanpa paket tambahan):
# MAIL_MAILER=smtp, MAIL_HOST=smtp.resend.com, MAIL_PORT=587,
# MAIL_USERNAME=resend, MAIL_PASSWORD=<API key Resend>, dan
# MAIL_FROM_ADDRESS di domain yang sudah diverifikasi di Resend.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Pitcar Academy lead intake ---
LEAD_CODE_PREFIX=PA
LEAD_SCORING_VERSION=2026-03
LEAD_RATE_LIMIT_PER_IP=10
LEAD_RATE_LIMIT_PER_WHATSAPP=3
# Number the wa.me link falls back to when no consultant row matches.
LEAD_FALLBACK_CONSULTANT_WHATSAPP=6285742228865

# Webhook otomasi WhatsApp Cekat AI. Dipanggil dari queue setelah lead
# tersimpan; kosongkan untuk mematikannya.
LEAD_WEBHOOK_URL=https://workflows.cekat.ai/webhook-test/<slug-kamu>

# Meta Conversions API. The token is a credential: it stays on this server and
# is never mirrored into a PUBLIC_* frontend variable. Leave it blank to turn
# server-side conversion reporting off entirely.
META_PIXEL_ID=1364110365687038
META_CAPI_ACCESS_TOKEN=
# Set while validating in Events Manager -> Test Events, then clear it.
META_CAPI_TEST_EVENT_CODE=
# Comma separated. Production must not include localhost.
# Origin frontend yang boleh memanggil API ini (CORS), dipisah koma.
# Production + origin local dev untuk testing popup/form.
LEAD_ALLOWED_ORIGINS=https://academy.pitcar.co.id,http://localhost:4321
LEAD_RETENTION_DAYS=
# false memasking nomor WhatsApp di export CSV.
LEAD_EXPORT_FULL_NUMBER=true

# --- Scalev Orders API (sales popup + buyer counter) ---
# Read-only API key with the order:list scope, from dev.scalev.com.
# Kosongkan untuk mematikan sync; command akan skip sendiri.
SCALEV_API_KEY=
SCALEV_API_URL=https://api.scalev.com

# --- DOKU Checkout (pembayaran kelas online) ---
# Client ID dan Secret Key dari DOKU Back Office > Settings > API Keys.
# Kosongkan untuk mematikan checkout; API menjawab 503.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Sandbox: https://api-sandbox.doku.com  Production: https://api.doku.com
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_PAYMENT_DUE_MINUTES=60
# Kosong = semua metode yang aktif di akun DOKU. Contoh:
# QRIS,EMONEY_SHOPEEPAY,EMONEY_OVO,EMONEY_DANA,VIRTUAL_ACCOUNT_BCA,PEER_TO_PEER_KREDIVO
DOKU_PAYMENT_METHODS=
# Halaman tujuan tombol "kembali" di halaman hasil DOKU; nomor pesanan ditambahkan sebagai ?order=.
DOKU_RETURN_URL=https://academy.pitcar.co.id/checkout/

# --- Admin pertama dashboard (dipakai sekali oleh DashboardUserSeeder) ---
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- kirimdev (akses kelas lewat WhatsApp) ---
# API key dan phone_number_id nomor WA Pitcar Academy dari dashboard kirimdev.
KIRIMDEV_API_KEY=
KIRIMDEV_PHONE_NUMBER_ID=
# Template utility yang sudah disetujui Meta. Variabel body: {{1}} nama depan,
# {{2}} judul kelas, {{3}} tautan masuk, {{4}} masa berlaku tautan, {{5}} email.
KIRIMDEV_ACCESS_TEMPLATE=academy_akses_kelas
KIRIMDEV_TEMPLATE_LANGUAGE=id
# false (saat ini): akses dikirim lewat email saja, admin bisa kirim WA manual dari menu Pesanan kelas.
# true: kirim WA otomatis setelah bayar. Nyalakan setelah template disetujui Meta.
KIRIMDEV_ACCESS_AUTO=false

# --- LMS kelas online ---
# Situs yang memuat /belajar/; tautan di email dan WA mengarah ke sini.
LMS_FRONTEND_URL=https://academy.pitcar.co.id
# Nilai sementara, menunggu keputusan owner.
LMS_COMPLETE_AT_PERCENT=90
LMS_LOGIN_LINK_MINUTES=30
LMS_PURCHASE_LINK_MINUTES=4320
LMS_SESSION_DAYS=30
LMS_CLAIM_HOURS=24

# --- Terbitkan ulang situs dari admin (harga landing page ikut CMS) ---
# Repo yang menjalankan workflow deploy, misalnya pemilik/pitcar-academy-lp.
# Token: fine-grained GitHub token, hanya repo itu, izin Actions: Read and write.
SITE_DEPLOY_REPO=
SITE_DEPLOY_TOKEN=
SITE_DEPLOY_WORKFLOW=deploy.yml
SITE_DEPLOY_REF=main

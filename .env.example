# ========================================
# Pitcar Academy Landing Page - Environment Variables
# ========================================

# Site URL (for production)
SITE_URL=https://academy.pitcar.co.id

# Public frontend configuration (embedded at build time; never put secrets here)
PUBLIC_LEAD_API_BASE_URL=
PUBLIC_EDUCATION_CONSULTANT_WHATSAPP=
# Footer contact details now live in src/content.config.ts.
# This one is only the wa.me fallback used when the API returns no link.
PUBLIC_EDUCATION_CONSULTANT_WHATSAPP_DISPLAY=
PUBLIC_GA_ID=

# Development
NODE_ENV=development

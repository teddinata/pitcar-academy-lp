# ========================================
# Pitcar Academy Landing Page - Environment Variables
# ========================================

# Site URL (for production)
SITE_URL=https://academy.pitcar.co.id

# Public frontend configuration (embedded at build time; never put secrets here)
PUBLIC_LEAD_API_BASE_URL=

# Nomor Education Consultant, dipakai membangun wa.me bila API tidak
# mengembalikan whatsapp_url. Di CI nilainya berasal dari secret WA_PHONE_NUMBER.
PUBLIC_EDUCATION_CONSULTANT_WHATSAPP=6285742228865
# Detail kontak footer ada di src/content.config.ts, bukan di sini.
PUBLIC_EDUCATION_CONSULTANT_WHATSAPP_DISPLAY=

# Properti GA4 yang sudah berjalan di academy.pitcar.co.id. Mengganti ID
# memutus riwayat, bukan memindahkannya. Ada nilai default di kode supaya
# analytics tidak pernah hilang diam-diam kalau variabel ini lupa diisi.
PUBLIC_GA_ID=G-FNT01JRZN7

# Hotjar site id. Public by nature — it is readable in the page source.
# Leave blank to build without session recording.
PUBLIC_HOTJAR_ID=6772321

# Meta pixel id. Public — it is readable in the page source. The Conversions
# API token is NOT set here: it is a credential and belongs in backend/.env,
# because every PUBLIC_* value is compiled into the browser bundle.
PUBLIC_META_PIXEL_ID=1364110365687038

# Development
NODE_ENV=development

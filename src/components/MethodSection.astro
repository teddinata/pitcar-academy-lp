---
import { learningMethod } from '../content.config';
---

<section id="metode" class="band band-paper border-t rule-paper scroll-mt-28" aria-labelledby="method-title">
  <div class="shell">
    <div class="max-w-3xl">
      <p class="eyebrow text-accent-paper">Metode</p>
      <h2 id="method-title" class="display-2 mt-6">Pitcar Learning Method</h2>
      <p class="lead mt-5 text-muted-paper">
        Lima tahap yang dilalui setiap peserta, dari konsep dasar sampai siap masuk dunia kerja.
      </p>
    </div>

    <!-- Horizontal rail on desktop, vertical on mobile: the order is the point,
         so the connector is drawn rather than implied by placement alone. -->
    <ol class="mt-14 grid gap-0 md:grid-cols-5">
      {learningMethod.map((step, index) => (
        <li class="relative flex gap-5 border-l-2 border-paper-line pb-10 pl-6 last:pb-0 md:block md:border-l-0 md:border-t-2 md:pb-0 md:pl-0 md:pr-6 md:pt-6">
          <span
            class="absolute -left-[7px] top-1 h-3 w-3 rounded-full bg-brand-600 md:-top-[7px] md:left-0"
            aria-hidden="true"
          ></span>
          <div>
            <span class="font-display text-sm font-semibold uppercase tracking-[0.14em] text-muted-paper">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="display-3 mt-1.5">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-paper">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

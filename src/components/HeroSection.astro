---
interface Props {
  whatsappNumber?: string;
  whatsappMessage?: string;
}

const { whatsappNumber: _whatsappNumber, whatsappMessage: _whatsappMessage } = Astro.props;
---

<section class="hero-minimal relative overflow-hidden bg-slate-950 text-white" aria-label="Hero">
  <div class="container-custom relative z-10 mx-auto flex min-h-[100dvh] items-center px-4 pb-20 pt-32 sm:px-6 md:pb-24 md:pt-36 lg:px-8">
    <div class="grid w-full items-center gap-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-24">
      <div class="max-w-3xl">
        <p class="hero-eyebrow mb-7 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.18em] text-brand-300">
          <span class="h-px w-8 bg-brand-500"></span>
          Batch perdana · Oktober 2026
        </p>

        <h1 class="hero-heading max-w-3xl font-heading text-5xl font-black uppercase italic leading-[0.98] tracking-[-0.045em] text-white sm:text-6xl md:text-7xl lg:text-[5.6rem]">
          Bangun skill.<br />
          Dapatkan pengalaman.<br />
          <em class="not-italic text-brand-400">Mulai kariermu.</em>
        </h1>

        <p class="mt-8 max-w-xl text-base leading-7 text-slate-300 sm:text-lg">
          Pelatihan mekanik mobil dengan teori, praktik intensif, dan 2 bulan On The Job Training di ekosistem bengkel PITCAR.
        </p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href="#cta" class="hero-link hero-link-primary">
            Daftar sekarang
            <span aria-hidden="true">→</span>
          </a>
          <a href="#packages" class="hero-link hero-link-secondary">
            Lihat paket belajar
          </a>
        </div>

        <dl class="mt-14 grid max-w-xl grid-cols-3 border-t border-white/15 pt-5">
          <div class="pr-4">
            <dt class="text-xs leading-5 text-slate-400">Belajar dari</dt>
            <dd class="mt-1 text-sm font-semibold text-white">Praktisi bengkel</dd>
          </div>
          <div class="border-l border-white/15 px-4">
            <dt class="text-xs leading-5 text-slate-400">Pengalaman</dt>
            <dd class="mt-1 text-sm font-semibold text-white">2 bulan OJT</dd>
          </div>
          <div class="border-l border-white/15 pl-4">
            <dt class="text-xs leading-5 text-slate-400">Hasil akhir</dt>
            <dd class="mt-1 text-sm font-semibold text-white">Sertifikat resmi</dd>
          </div>
        </dl>
      </div>

      <figure class="relative lg:justify-self-end">
        <div class="hero-image-frame relative overflow-hidden border border-white/15 bg-slate-900">
          <img
            src="/mechanic-hero.png"
            alt="Mekanik Pitcar Academy melakukan diagnosa mesin mobil"
            class="aspect-[4/5] w-full object-cover object-top"
            loading="eager"
            fetchpriority="high"
            width="600"
            height="800"
          />
        </div>
        <figcaption class="mt-4 flex items-start justify-between gap-5 border-t border-white/15 pt-3 text-xs text-slate-400">
          <span>Praktik langsung di lingkungan bengkel nyata</span>
          <span class="whitespace-nowrap font-mono text-brand-300">PITCAR / 01</span>
        </figcaption>
      </figure>
    </div>
  </div>

  <div class="hero-index absolute bottom-7 right-6 hidden font-mono text-xs text-slate-500 md:block lg:right-10">
    01 — ACADEMY
  </div>
</section>

<style>
  .hero-minimal {
    font-family: "Helvetica Neue", Arial, sans-serif;
  }

  .hero-eyebrow {
    animation: hero-reveal 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-heading,
  .hero-heading + p,
  .hero-link,
  .hero-image-frame,
  .hero-image-frame + figcaption,
  .hero-minimal dl {
    animation: hero-reveal 700ms cubic-bezier(0.16, 1, 0.3, 1) 100ms both;
  }

  .hero-image-frame {
    max-width: 31rem;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border-radius: 0.375rem;
    padding: 0.875rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    transition: background-color 200ms ease, color 200ms ease, transform 200ms ease;
  }

  .hero-link:active {
    transform: scale(0.98);
  }

  .hero-link-primary {
    background: #cc0000;
    color: white;
  }

  .hero-link-primary:hover {
    background: #aa0000;
  }

  .hero-link-secondary {
    border: 1px solid rgb(255 255 255 / 20%);
    color: rgb(255 255 255 / 82%);
  }

  .hero-link-secondary:hover {
    background: rgb(255 255 255 / 8%);
    color: white;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .hero-heading,
    .hero-heading + p,
    .hero-link,
    .hero-image-frame,
    .hero-image-frame + figcaption,
    .hero-minimal dl {
      animation: none;
    }
  }
</style>

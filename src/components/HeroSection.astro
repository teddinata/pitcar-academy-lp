---
const trustChips = [
  'Praktik langsung',
  'Trainer praktisi',
  'OJT di bengkel',
  'Assessment kompetensi',
  'Career opportunity',
];
---

<section class="band-ink relative overflow-hidden pt-28 pb-16 sm:pt-32 md:pt-40 md:pb-24" aria-labelledby="hero-title">
  <div class="shell">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16 lg:items-center">
      <!-- Copy -->
      <div class="lg:col-span-7">
        <p class="eyebrow text-accent-ink">Pitcar Academy</p>

        <h1 id="hero-title" class="display-1 mt-6 max-w-[15ch] text-paper">
          Belajar mekanik di bengkel nyata.
          <span class="block text-muted-ink">Bukan hanya di ruang kelas.</span>
        </h1>

        <p class="lead mt-7 max-w-prose text-stone-300">
          Bangun kompetensi mekanik melalui teori, praktik intensif, dan pengalaman
          langsung di ekosistem bengkel PITCAR.
        </p>

        <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-3">
          {trustChips.map((chip) => (
            <li class="flex items-center gap-2.5 text-sm font-semibold text-stone-300">
              <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              {chip}
            </li>
          ))}
        </ul>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href="#konsultasi" data-lead-cta data-source-cta="hero_primary" class="btn btn-primary">
            Konsultasi Program Gratis
            <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
          <a href="#program" class="btn btn-ghost-ink">Lihat Program &amp; Kurikulum</a>
        </div>

        <p class="mt-5 text-sm text-muted-ink">Gratis, tanpa kewajiban mendaftar.</p>
      </div>

      <!-- Visual -->
      <div class="lg:col-span-5">
        <figure class="relative">
          <img
            src="/mechanic-hero.webp"
            alt="Mekanik Pitcar Academy melakukan diagnosa mesin kendaraan di area kerja bengkel"
            width="720"
            height="720"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="aspect-[4/5] w-full object-cover object-top sm:aspect-square lg:aspect-[4/5]"
          />
          <figcaption class="mt-4 flex items-start gap-3 border-l-2 border-brand-600 pl-4 text-sm leading-relaxed text-muted-ink">
            Peserta belajar di lingkungan bengkel yang melayani kendaraan customer setiap hari.
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

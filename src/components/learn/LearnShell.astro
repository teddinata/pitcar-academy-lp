---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../ThemeToggle.astro';
import '../../styles/garage.css';

interface Props {
  title: string;
  /** The login page has no session, so it shows no account controls. */
  signedOut?: boolean;
}
const { title, signedOut = false } = Astro.props;
---

<BaseLayout title={`${title} | Pitcar Academy`} description="Area belajar peserta kelas online Pitcar Academy." world="garage" bare ownThemeToggle noindex>
  <div class="learn pt-4 pb-20 sm:pt-6" data-learn-root>
    <div class="shell">
      <header class="mb-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-line pb-3 lg:mb-12">
        <a href={signedOut ? '/kelas-online/' : '/belajar/'} class="inline-flex min-h-11 items-center gap-[0.3em] font-display text-xl font-bold uppercase !text-inherit !no-underline">
          Pitcar <span class="text-accent">Academy</span>
        </a>
        <nav class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm font-semibold" aria-label="Area belajar">
          {!signedOut && (
            <>
              <a href="/belajar/" class="inline-flex min-h-11 items-center !text-inherit !no-underline hover:!text-accent">Kelas saya</a>
              <a href="/belajar/masukan/" class="inline-flex min-h-11 items-center !text-inherit !no-underline hover:!text-accent">Masukan</a>
              <a href="/belajar/akun/" class="inline-flex min-h-11 items-center !text-inherit !no-underline hover:!text-accent">Akun<span class="ml-1.5 hidden max-w-[16ch] truncate font-normal text-muted sm:inline" data-student-name></span></a>
              <button type="button" class="learn-link min-h-11" data-logout>Keluar</button>
            </>
          )}
          <ThemeToggle />
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* Layout utilities such as flex and grid outrank the hidden attribute. */
  .learn [hidden] {
    display: none !important;
  }
  /* Headings take focus only from script, to move a screen reader to the new state. */
  .learn [tabindex='-1']:focus {
    outline: none;
  }
  /* Links inside running text carry no other cue, so they keep an underline. */
  .learn main :is(p, dd, li) > a:not(.btn) {
    color: rgb(var(--body));
    text-decoration: underline;
  }
  .learn main :is(p, dd, li) > a:not(.btn):hover {
    color: rgb(var(--accent));
  }
  .learn-link {
    font-weight: 600;
    color: rgb(var(--body));
    text-decoration: underline;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }
  .learn-link:hover {
    color: rgb(var(--accent));
  }
  .learn-input {
    min-height: 3rem;
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    color: rgb(var(--body));
    background: rgb(var(--surface));
    border: 1px solid rgb(var(--muted));
    border-radius: 2px;
  }
  .learn-input:focus-visible {
    outline: 2px solid rgb(var(--accent));
    outline-offset: 2px;
  }
  textarea.learn-input {
    min-height: 7.5rem;
    resize: vertical;
    line-height: 1.6;
  }
  select.learn-input {
    cursor: pointer;
  }
  /* A native radio dressed as the world's chip: arrow keys move between
     options, and the chosen one takes the red fill like a selected chip. */
  .learn-choice {
    position: relative;
    display: flex;
    cursor: pointer;
  }
  .learn-choice > input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .learn-choice > span {
    display: flex;
    width: 100%;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.875rem;
    border: 1px solid rgb(var(--muted));
    background-color: rgb(var(--ground));
    color: rgb(var(--body));
    white-space: nowrap;
    transition: border-color 200ms ease, background-color 200ms ease, color 200ms ease;
  }
  .learn-choice:hover > span {
    border-color: rgb(var(--body));
  }
  .learn-choice:active > span {
    background-color: rgb(var(--ground-alt));
  }
  .learn-choice > input:checked + span {
    border-color: #cc0000;
    background-color: #cc0000;
    color: #ffffff;
  }
  .learn-choice > input:focus-visible + span {
    outline: 3px solid rgb(var(--accent));
    outline-offset: 3px;
  }
  .learn-choice > input:disabled + span {
    cursor: not-allowed;
    opacity: 0.6;
  }
  .learn-error {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(var(--accent));
  }
  .learn-tab {
    min-height: 3rem;
    margin-bottom: -1px;
    padding: 0 1rem;
    font-weight: 600;
    color: rgb(var(--muted));
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }
  .learn-tab:hover {
    color: rgb(var(--body));
  }
  .learn-tab[aria-pressed='true'] {
    color: rgb(var(--body));
    border-bottom-color: rgb(var(--accent));
  }
  .learn-bar {
    height: 6px;
    background: rgb(var(--line));
  }
  .learn-bar > span {
    display: block;
    height: 100%;
    background: #cc0000;
    transition: width 300ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .learn-bar > span {
      transition: none;
    }
  }
  .learn button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }
</style>

<script>
  import { api, session } from '../../scripts/learn/api';

  document.querySelector('[data-logout]')?.addEventListener('click', async () => {
    try {
      await api('/learn/session', { method: 'DELETE' });
    } catch {
      /* the local session is dropped either way */
    }
    session.clear();
    location.href = '/belajar/masuk/';
  });
</script>

---
const homePrefix = Astro.url.pathname === '/' ? '' : '/';
const consultationHref = `${homePrefix}#konsultasi`;
const whatsappDisplay = import.meta.env.PUBLIC_EDUCATION_CONSULTANT_WHATSAPP_DISPLAY;
const year = new Date().getFullYear();

const links = [
  { href: `${homePrefix}#metode`, label: 'Metode belajar' },
  { href: `${homePrefix}#program`, label: 'Program & biaya' },
  { href: `${homePrefix}#perjalanan`, label: 'Perjalanan belajar' },
  { href: '/faq/', label: 'FAQ' },
];
---

<footer class="border-t rule-ink bg-ink text-paper">
  <div class="shell py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-6">
        <p class="font-display text-2xl font-bold leading-none">
          <span class="text-paper">PITCAR</span><span class="text-brand-400">ACADEMY</span>
        </p>
        <p class="lead mt-5 max-w-prose text-muted-ink">
          Pelatihan mekanik dengan praktik intensif dan pengalaman langsung di
          ekosistem bengkel PITCAR.
        </p>
        <a href={consultationHref} data-lead-cta data-source-cta="footer_consultation" class="btn btn-primary mt-8">
          Konsultasi Program Gratis
        </a>
      </div>

      <nav class="md:col-span-3" aria-label="Tautan halaman">
        <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-muted-ink">Halaman</h2>
        <ul class="mt-5 space-y-3">
          {links.map((link) => (
            <li>
              <a class="text-stone-300 transition-colors hover:text-paper" href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-3">
        <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-muted-ink">Kontak</h2>
        <ul class="mt-5 space-y-3 text-stone-300">
          {whatsappDisplay && <li>WhatsApp {whatsappDisplay}</li>}
          <li>
            <a class="transition-colors hover:text-paper" href="https://pitcar.co.id" rel="noopener noreferrer" target="_blank">
              pitcar.co.id
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t rule-ink">
    <div class="shell flex flex-col gap-2 py-5 text-xs text-stone-400 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Pitcar Academy. Bagian dari ekosistem PITCAR.</p>
      <p>Sertifikat kelulusan program, bukan sertifikasi kompetensi nasional.</p>
    </div>
  </div>
</footer>

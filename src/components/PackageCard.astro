---
// PackageCard.astro — Clean, High-Contrast Pricing Card with brand colors
import type { PackageItem } from '../content.config';

interface Props {
  pkg: PackageItem;
}

const { pkg } = Astro.props;
---

<div
  class={`relative flex flex-col rounded-2xl transition-all duration-300 group ${
    pkg.highlight
      ? 'bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 border-2 border-primary text-white md:-translate-y-4 md:scale-[1.03] z-10'
      : 'bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-lg hover:shadow-xl text-slate-900 dark:text-white'
  }`}
>
  {/* Popular Badge */}
  {
    pkg.highlight && (
      <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-primary text-white font-extrabold text-[11px] uppercase tracking-widest px-5 py-2 rounded-full shadow-[0_4px_8px_rgba(204,0,0,0.3)] z-20 flex items-center gap-1.5 whitespace-nowrap">
        <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
        🔥 Paling Diminati & Hemat
      </div>
    )
  }

  <div class="p-6 sm:p-8 flex-1 flex flex-col">
    <!-- Header Level -->
    <div class="flex items-center justify-between mb-4">
      <span
        class={`font-black text-xs uppercase tracking-wider px-3.5 py-1.5 rounded-full ${
          pkg.highlight
            ? 'bg-primary text-white border border-primary/20 shadow-md shadow-primary/20'
            : 'bg-primary/5 text-primary border border-primary/20'
        }`}
      >
        {pkg.level}
      </span>
      <span class={`text-xs font-bold ${pkg.highlight ? 'text-brand-300' : 'text-slate-500 dark:text-slate-400'}`}>
        Kick Off: {pkg.kickOff}
      </span>
    </div>

    <!-- Title & Subtitle -->
    <h3 class="text-xl sm:text-2xl font-black leading-snug mb-2">{pkg.name}</h3>
    <p class={`text-xs leading-relaxed mb-6 font-medium ${pkg.highlight ? 'text-slate-300' : 'text-slate-600 dark:text-slate-400'}`}>
      {pkg.subtitle}
    </p>

    <!-- Pricing -->
    <div class={`mb-6 pb-6 border-b ${pkg.highlight ? 'border-slate-700' : 'border-slate-200 dark:border-slate-800'}`}>
      <div class={`text-xs uppercase font-bold mb-1 ${pkg.highlight ? 'text-slate-400' : 'text-slate-500 dark:text-slate-400'}`}>Investasi Program</div>
      {pkg.strikePriceDisplay && (
        <div class="text-sm md:text-base font-bold text-slate-500 line-through mb-0.5 decoration-red-500 decoration-2">
          {pkg.strikePriceDisplay}
        </div>
      )}
      <div class="text-3xl sm:text-4xl font-black tracking-tight mb-2">{pkg.priceDisplay}</div>
      <div class="flex flex-col gap-2 items-start">
        {
          pkg.savingsNote && (
            <div class={`inline-block px-3 py-1 border font-bold text-xs rounded-lg ${
              pkg.highlight
                ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400 shadow-sm'
                : 'bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400'
            }`}>
              🎉 {pkg.savingsNote}
            </div>
          )
        }
        {
          pkg.scarcityNote && (
            <div class={`inline-block px-3 py-1.5 border font-bold text-xs rounded-lg ${
              pkg.highlight
                ? 'bg-red-500/10 border-red-500/30 text-red-300 shadow-sm'
                : 'bg-red-50 border-red-200 text-red-700'
            }`}>
              ⏳ {pkg.scarcityNote}
            </div>
          )
        }
      </div>
    </div>

    <!-- Specs Grid -->
    <div class={`grid grid-cols-2 gap-3 mb-6 p-4 rounded-xl border text-xs ${
      pkg.highlight ? 'bg-slate-950/40 border-slate-700' : 'bg-slate-50 dark:bg-slate-950/40 border-slate-100 dark:border-slate-800'
    }`}>
      <div>
        <span class={`block font-medium ${pkg.highlight ? 'text-slate-400' : 'text-slate-500 dark:text-slate-400'}`}>Jam Belajar</span>
        <strong class="font-bold text-sm">{pkg.hours}</strong>
      </div>
      <div>
        <span class={`block font-medium ${pkg.highlight ? 'text-slate-400' : 'text-slate-500'}`}>Praktik Bengkel</span>
        <strong class="font-bold text-sm text-primary">{pkg.ojt}</strong>
      </div>
    </div>

    <!-- Materials List -->
    <div class="mb-8 flex-1">
      <div class={`text-xs font-bold uppercase tracking-wider mb-3 ${pkg.highlight ? 'text-slate-400' : 'text-slate-500 dark:text-slate-400'}`}>Materi Utama:</div>
      <ul class="space-y-2.5">
        {pkg.materials.map(item => (
          <li class="flex items-start gap-2.5 text-xs sm:text-sm font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="shrink-0 mt-0.5 text-primary" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Action CTA -->
    <a
      href="#konsultasi"
      data-lead-cta
      data-program-interest={pkg.id}
      data-source-cta={`package_${pkg.id}`}
      class={`w-full py-4 px-6 rounded-full font-bold text-center text-sm transition-all duration-300 flex items-center justify-center gap-2 shadow-lg ${
        pkg.highlight
          ? 'bg-primary hover:bg-secondary text-white border border-primary hover:scale-[1.02] active:scale-[0.98] shadow-primary/20 shadow-lg'
          : 'bg-slate-900 hover:bg-slate-800 text-white hover:scale-[1.01]'
      }`}
    >
      <span>Konsultasi Program {pkg.level}</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class={`transition-transform duration-300 ${pkg.highlight ? 'group-hover:translate-x-1.5' : ''}`} stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</div>

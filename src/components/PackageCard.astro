---
import type { PackageItem } from '../content.config';

interface Props {
  pkg: PackageItem;
}

const { pkg } = Astro.props;

// Value, then outcome, then benefit, then price. Leading with a discount makes
// a Rp5 juta program look like it is struggling to sell.
const facts = [
  { label: 'Durasi kelas', value: `${pkg.duration} · ${pkg.hours}` },
  { label: 'On the job training', value: pkg.ojt },
  { label: 'Sertifikat', value: pkg.certificate },
  { label: 'Batch terdekat', value: pkg.kickOff },
];
---

<article
  class:list={[
    'flex flex-col',
    pkg.highlight ? 'card-ink text-paper' : 'card-paper',
  ]}
>
  <div class="flex flex-1 flex-col p-6 sm:p-8">
    <!-- Wraps rather than shrinks: side by side the eyebrow and badge overflow
         a 390px viewport, and a clipped badge is worse than a second line. -->
    <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
      <p class:list={['eyebrow', pkg.highlight ? 'text-accent-ink' : 'text-accent-paper']}>
        {pkg.level}
      </p>
      {pkg.badge && (
        <span class="border border-brand-600 bg-brand-600 px-2.5 py-1 text-[0.6875rem] font-bold uppercase tracking-wider text-white">
          {pkg.badge}
        </span>
      )}
    </div>

    <h3 class="display-3 mt-5">{pkg.name}</h3>

    <p class:list={['mt-3 text-sm leading-relaxed', pkg.highlight ? 'text-muted-ink' : 'text-muted-paper']}>
      {pkg.subtitle}
    </p>

    <!-- Outcome before spec: what you can do matters more than what you sat through. -->
    <div class:list={['mt-7 border-t pt-6', pkg.highlight ? 'rule-ink' : 'rule-paper']}>
      <p class="text-xs font-bold uppercase tracking-[0.14em]">Yang didapat</p>
      <ul class="mt-4 space-y-2.5">
        {pkg.outcomes.map((outcome) => (
          <li class="flex gap-3 text-sm leading-relaxed">
            <svg aria-hidden="true" class:list={['mt-0.5 h-4 w-4 shrink-0', pkg.highlight ? 'text-brand-400' : 'text-brand-600']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span class:list={[pkg.highlight ? 'text-stone-300' : 'text-muted-paper']}>{outcome}</span>
          </li>
        ))}
      </ul>
    </div>

    <dl class:list={['mt-6 space-y-3 border-t pt-6 text-sm', pkg.highlight ? 'rule-ink' : 'rule-paper']}>
      {facts.map((fact) => (
        <div>
          <dt class:list={['text-xs uppercase tracking-wider', pkg.highlight ? 'text-muted-ink' : 'text-muted-paper']}>
            {fact.label}
          </dt>
          <dd class="mt-0.5 font-semibold leading-snug">{fact.value}</dd>
        </div>
      ))}
    </dl>

    <!-- Price last, and framed as an investment in the batch rather than a sale. -->
    <div class:list={['mt-8 border-t pt-6', pkg.highlight ? 'rule-ink' : 'rule-paper']}>
      <p class="text-xs font-bold uppercase tracking-[0.14em]">Investasi program</p>
      <div class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span class="font-display text-4xl font-bold leading-none">{pkg.priceDisplay}</span>
        {pkg.strikePriceDisplay && (
          <span class:list={['text-base line-through', pkg.highlight ? 'text-muted-ink' : 'text-muted-paper']}>
            {pkg.strikePriceDisplay}
          </span>
        )}
      </div>
      {pkg.savingsNote && (
        <p class:list={['mt-2 text-sm font-semibold', pkg.highlight ? 'text-accent-ink' : 'text-accent-paper']}>
          {pkg.savingsNote}
        </p>
      )}
      {pkg.scarcityNote && (
        <p class:list={['mt-1 text-xs', pkg.highlight ? 'text-muted-ink' : 'text-muted-paper']}>
          {pkg.scarcityNote}
        </p>
      )}
    </div>

    <a
      href="#konsultasi"
      data-lead-cta
      data-program-interest={pkg.id}
      data-source-cta={`package_${pkg.id}`}
      class:list={['btn mt-7 w-full', pkg.highlight ? 'btn-primary' : 'btn-ghost-paper']}
    >
      Konsultasikan program ini
    </a>
  </div>
</article>

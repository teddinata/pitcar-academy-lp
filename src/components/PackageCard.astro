---
import type { PackageItem } from '../content.config';

interface Props {
  pkg: PackageItem;
}

const { pkg } = Astro.props;

// Value, then outcome, then facts, then price. Leading with a discount makes a
// Rp5 juta program look like it is struggling to sell.
const facts = [
  { label: 'Durasi kelas', value: `${pkg.duration} · ${pkg.hours}` },
  { label: 'On the job training', value: pkg.ojt },
  { label: 'Sertifikat', value: pkg.certificate },
  { label: 'Batch terdekat', value: pkg.kickOff },
];
---

<!-- Emphasis is an accent edge, not an inverted ground: on a uniform page a
     dark card would vanish in dark mode and shout in light mode. -->
<article class:list={['flex flex-col', pkg.highlight ? 'card-featured' : 'card']}>
  <div class="flex flex-1 flex-col p-6 sm:p-8">
    <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
      <p class="eyebrow">{pkg.level}</p>
      {pkg.badge && (
        <span class="bg-accent-fill px-2.5 py-1 text-[0.6875rem] font-bold uppercase tracking-wider text-white">
          {pkg.badge}
        </span>
      )}
    </div>

    <h3 class="display-3 mt-5">{pkg.name}</h3>

    <p class="mt-3 text-sm leading-relaxed text-muted">{pkg.subtitle}</p>

    <div class="mt-7 border-t border-line pt-6">
      <p class="text-xs font-bold uppercase tracking-[0.14em]">Yang didapat</p>
      <ul class="mt-4 space-y-2.5">
        {pkg.outcomes.map((outcome) => (
          <li class="flex gap-3 text-sm leading-relaxed">
            <svg aria-hidden="true" class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span class="text-muted">{outcome}</span>
          </li>
        ))}
      </ul>
    </div>

    <dl class="mt-6 space-y-3 border-t border-line pt-6 text-sm">
      {facts.map((fact) => (
        <div>
          <dt class="text-xs uppercase tracking-wider text-muted">{fact.label}</dt>
          <dd class="mt-0.5 font-semibold leading-snug">{fact.value}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-8 border-t border-line pt-6">
      <p class="text-xs font-bold uppercase tracking-[0.14em]">Investasi program</p>
      {pkg.priceLadder && (
        <dl class="mt-3 space-y-1.5 text-xs sm:text-sm">
          {pkg.priceLadder.map((rung) => (
            <div class="flex items-baseline justify-between gap-x-3">
              <dt class="text-muted">{rung.label}</dt>
              <dd class="whitespace-nowrap text-muted line-through">{rung.value}</dd>
            </div>
          ))}
        </dl>
      )}

      <div class:list={['flex flex-wrap items-baseline gap-x-3 gap-y-1', pkg.priceLadder ? 'mt-4 border-t border-line pt-4' : 'mt-3']}>
        <span class="font-display text-4xl font-bold leading-none">{pkg.priceDisplay}</span>
        {pkg.strikePriceDisplay && !pkg.priceLadder && (
          <span class="text-lg text-muted line-through">{pkg.strikePriceDisplay}</span>
        )}
      </div>

      {pkg.savingsNote && (
        <p class="mt-2 text-sm font-semibold text-accent">{pkg.savingsNote}</p>
      )}
      {pkg.scarcityNote && (
        <p class="mt-1 text-xs text-muted">{pkg.scarcityNote}</p>
      )}
    </div>

    <a
      href="#konsultasi"
      data-lead-cta
      data-program-interest={pkg.id}
      data-source-cta={`package_${pkg.id}`}
      class:list={['btn mt-7 w-full', pkg.highlight ? 'btn-primary' : 'btn-ghost']}
    >
      Konsultasikan program ini
    </a>
  </div>
</article>

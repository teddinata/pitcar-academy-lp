---
const href = Astro.url.pathname === '/' ? '#konsultasi' : '/#konsultasi';
---

<!-- Brand red, not WhatsApp green: this opens the consultation form, and a
     green button would promise a chat that does not start yet. -->
<a
  href={href}
  data-lead-cta
  data-source-cta="floating_consultation"
  data-floating-consultation
  class="btn btn-primary pointer-events-none fixed bottom-4 right-4 z-40 translate-y-2 px-5 py-3 text-sm opacity-0 shadow-lg transition duration-200 sm:bottom-6 sm:right-6"
>
  <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path><path d="M8 9h8"></path><path d="M8 13h5"></path></svg>
  Konsultasi gratis
</a>

<script>
  const floatingButton = document.querySelector<HTMLElement>('[data-floating-consultation]');
  // Watch every consultation CTA on the page, not just the hero: the revamped
  // page has one in most sections, and a floating button that sits on top of
  // the card it duplicates is worse than no floating button.
  const anchors = [
    ...document.querySelectorAll<HTMLElement>('[data-lead-cta]:not([data-floating-consultation])'),
    ...document.querySelectorAll<HTMLElement>('#konsultasi'),
  ];
  const visibility = new Map<Element, boolean>();

  function updateFloatingButton() {
    if (!floatingButton) return;
    // Hidden whenever a real CTA is already on screen, so it never competes
    // with the form it points at.
    const shouldHide = [...visibility.values()].some(Boolean);
    floatingButton.classList.toggle('opacity-0', shouldHide);
    floatingButton.classList.toggle('pointer-events-none', shouldHide);
    floatingButton.classList.toggle('translate-y-2', shouldHide);
    floatingButton.classList.toggle('opacity-100', !shouldHide);
    floatingButton.classList.toggle('pointer-events-auto', !shouldHide);
    floatingButton.classList.toggle('translate-y-0', !shouldHide);
  }

  if (floatingButton && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => visibility.set(entry.target, entry.isIntersecting));
      updateFloatingButton();
    }, { threshold: 0.05 });
    anchors.forEach((anchor) => observer.observe(anchor));
  }
</script>

---
import { problems, problemResolution } from '../content.config';
---

<section class="band band-paper" aria-labelledby="problem-title">
  <div class="shell">
    <div class="max-w-3xl">
      <p class="eyebrow text-accent-paper">Masalahnya</p>
      <h2 id="problem-title" class="display-2 mt-6">Kenapa belajar teori saja tidak cukup?</h2>
    </div>

    <ol class="mt-14 grid gap-px border rule-paper bg-paper-line md:grid-cols-3">
      {problems.map((problem, index) => (
        <li class="bg-paper px-6 py-9 sm:px-8">
          <span class="font-display text-sm font-semibold uppercase tracking-[0.14em] text-accent-paper">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="display-3 mt-2">{problem.title}</h3>
          <p class="mt-3 leading-relaxed text-muted-paper">{problem.description}</p>
        </li>
      ))}
    </ol>

    <p class="display-3 mt-14 max-w-3xl border-l-2 border-brand-600 pl-6">
      {problemResolution}
    </p>
  </div>
</section>

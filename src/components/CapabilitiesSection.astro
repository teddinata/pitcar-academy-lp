---
import { capabilities } from '../content.config';
---

<section class="band border-t border-line" aria-labelledby="capabilities-title">
  <div class="shell">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow text-accent">Hasil belajar</p>
        <h2 id="capabilities-title" class="display-2 mt-6">
          Setelah menyelesaikan program, kamu diharapkan mampu:
        </h2>
        <p class="lead mt-6 text-muted">
          Bukan daftar mata pelajaran. Ini pekerjaan yang bisa kamu kerjakan sendiri
          setelah lulus.
        </p>
      </div>

      <div class="lg:col-span-7">
        <ul class="divide-y divide-line border-y border-line">
          {capabilities.map((item) => (
            <li class="flex items-start gap-4 py-5">
              <svg aria-hidden="true" class="mt-1 h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span class="text-lg leading-snug">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

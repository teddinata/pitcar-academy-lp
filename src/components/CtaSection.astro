---
import LeadForm from './LeadForm.astro';

const steps = [
  'Pilih program, atau minta rekomendasi berdasarkan latar belakangmu.',
  'Education Consultant menerima konteksmu sebelum percakapan dimulai.',
  'Konsultasi gratis, tanpa kewajiban langsung mendaftar.',
];
---

<section id="consultation" class="band border-t border-line" aria-labelledby="consultation-title">
  <span id="cta" class="sr-only" aria-hidden="true"></span>

  <div class="shell">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16 lg:items-start">
      <div class="lg:col-span-5 lg:sticky lg:top-32">
        <p class="eyebrow text-accent">Langkah berikutnya</p>
        <h2 id="consultation-title" class="display-2 mt-6 text-body">
          Siap membangun skill mekanikmu?
        </h2>
        <p class="lead mt-6 text-muted">
          Ceritakan tujuanmu kepada Education Consultant Pitcar Academy. Kami akan
          membantu merekomendasikan program yang paling sesuai.
        </p>

        <ol class="mt-10 space-y-5">
          {steps.map((step, index) => (
            <li class="flex gap-4">
              <span class="font-display text-sm font-bold text-accent" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="text-muted">{step}</span>
            </li>
          ))}
        </ol>

        <p class="mt-10 border-t border-line pt-6 text-sm text-muted">
          Batch terdekat Oktober 2026 · Basic mulai Rp5.000.000
        </p>
      </div>

      <div id="konsultasi" class="scroll-mt-28 lg:col-span-7">
        <LeadForm />
      </div>
    </div>
  </div>
</section>

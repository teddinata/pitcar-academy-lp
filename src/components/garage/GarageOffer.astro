---
import { livePriceAttrs } from '../../lib/livePrices';
import LeadForm from '../LeadForm.astro';
import {
  careerStatement,
  faqs,
  foundingBatchBenefits,
  onlineCourses,
  packages,
  parentReadiness,
  parentStatement,
  programFacts,
  type PackageItem,
} from '../../content.config';

// The shared content file still separates clauses with a long dash. This page
// sets them with ordinary punctuation instead of editing copy other pages use.
const tidy = (text: string, joiner = ', ') => text.replaceAll(' — ', joiner);

const single = packages.filter((pkg) => !pkg.highlight);
const complete = packages.find((pkg) => pkg.highlight);
const benefits = foundingBatchBenefits.filter((item) => item.publish);

const factsFor = (pkg: PackageItem) => [
  { label: 'Durasi kelas', value: `${pkg.duration}, ${pkg.hours}` },
  { label: 'On the job training', value: pkg.ojt },
  { label: 'Sertifikat', value: tidy(pkg.certificate) },
  { label: 'Batch terdekat', value: pkg.kickOff },
];

const careerPath = [
  { step: 'Lulus program', detail: 'Menyelesaikan kelas, praktik, OJT, dan assessment.' },
  { step: 'Sertifikat kelulusan', detail: 'Bukti penyelesaian sesuai program yang diambil.' },
  { step: 'Kesempatan seleksi', detail: 'Peserta dengan performa sesuai kebutuhan dapat mengikuti proses rekrutmen.' },
  { step: 'Karier mekanik', detail: 'Masuk dunia kerja otomotif dengan pengalaman bengkel nyata.' },
];

const consultationSteps = [
  'Pilih program, atau minta rekomendasi berdasarkan latar belakangmu.',
  'Education Consultant menerima konteksmu sebelum percakapan dimulai.',
  'Konsultasi gratis, tanpa kewajiban langsung mendaftar.',
];
---

<section id="program" class="g-section scroll-mt-28" aria-labelledby="packages-title">
  <div class="shell">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-16">
      <h2 id="packages-title" class="g-h2 lg:col-span-7">Pilih jalur yang sesuai dengan tujuanmu.</h2>
      <p class="leading-relaxed text-muted lg:col-span-5">
        Dua level yang bisa diambil terpisah, atau keduanya sekaligus. Kalau belum yakin, konsultan kami membantu memilihkan berdasarkan latar belakang dan targetmu.
      </p>
    </div>

    <div class="mt-14 grid border-t border-body md:grid-cols-2">
      {single.map((pkg, index) => (
        <article class:list={['flex flex-col py-9', index === 0 ? 'border-b border-line md:border-b-0 md:border-r md:pr-10' : 'md:pl-10']}>
          <p class="g-label text-accent">{pkg.level}</p>
          <h3 class="g-h3 mt-3">{tidy(pkg.name, ': ')}</h3>
          <p class="mt-3 leading-relaxed text-muted">{pkg.subtitle}</p>

          <ul class="mt-7 space-y-2.5">
            {pkg.outcomes.map((outcome) => <li class="g-node leading-relaxed">{outcome}</li>)}
          </ul>

          <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-line pt-6 text-sm">
            {factsFor(pkg).map((fact) => (
              <div>
                <dt class="text-muted">{fact.label}</dt>
                <dd class="mt-0.5 font-semibold leading-snug">{fact.value}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-8 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="g-num text-5xl">{pkg.priceDisplay}</span>
            {pkg.strikePriceDisplay && <span class="text-lg text-muted line-through">{pkg.strikePriceDisplay}</span>}
          </div>
          {pkg.savingsNote && <p class="mt-2 text-sm font-semibold text-accent">{pkg.savingsNote}</p>}
          {pkg.scarcityNote && <p class="mt-1 text-sm text-muted">{pkg.scarcityNote}</p>}

          <a href="#konsultasi" data-lead-cta data-program-interest={pkg.id} data-source-cta={`package_${pkg.id}`} class="btn btn-ghost mt-7 self-start">
            Konsultasikan {pkg.level.toLowerCase()}
          </a>
        </article>
      ))}
    </div>

    {complete && (
      <article class="grid gap-10 border-t-2 border-accent-fill bg-ground-alt p-6 sm:p-9 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <p class="g-label text-accent">{complete.level}{complete.badge && `, ${complete.badge.toLowerCase()}`}</p>
          <h3 class="g-h2 mt-3">Level 1 + Level 2</h3>
          <p class="mt-4 max-w-prose leading-relaxed text-muted">{complete.subtitle}</p>
          <ul class="mt-7 space-y-2.5">
            {complete.outcomes.map((outcome) => <li class="g-node leading-relaxed">{outcome}</li>)}
          </ul>
          <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-line pt-6 text-sm sm:grid-cols-4">
            {factsFor(complete).map((fact) => (
              <div>
                <dt class="text-muted">{fact.label}</dt>
                <dd class="mt-0.5 font-semibold leading-snug">{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="lg:col-span-5">
          {complete.priceLadder && (
            <dl class="space-y-2 text-sm">
              {complete.priceLadder.map((rung) => (
                <div class="flex items-baseline justify-between gap-x-3">
                  <dt class="text-muted">{rung.label}</dt>
                  <dd class="whitespace-nowrap text-muted line-through">{rung.value}</dd>
                </div>
              ))}
            </dl>
          )}
          <p class="g-num mt-5 border-t border-line pt-5 text-6xl md:text-7xl">{complete.priceDisplay}</p>
          {complete.savingsNote && <p class="mt-3 text-sm font-semibold text-accent">{complete.savingsNote}</p>}
          {complete.scarcityNote && <p class="mt-1 text-sm text-muted">{complete.scarcityNote}</p>}
          <a href="#konsultasi" data-lead-cta data-program-interest={complete.id} data-source-cta={`package_${complete.id}`} class="btn btn-primary mt-7 w-full">
            Konsultasikan program lengkap
          </a>
        </div>
      </article>
    )}

    <p class="mt-6 text-sm text-muted">Tersedia opsi pembayaran bertahap. Diskusikan saat konsultasi.</p>

    {benefits.length > 0 && (
      <div class="mt-20 grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h3 class="g-h3">Keuntungan angkatan pertama</h3>
          <p class="mt-3 leading-relaxed text-muted">
            Kelompok pertama yang menjalani program ini mendapat perlakuan berbeda, bukan karena diskon, tetapi karena jumlahnya dibatasi.
          </p>
        </div>
        <dl class="grid gap-8 sm:grid-cols-3 lg:col-span-8">
          {benefits.map((benefit) => (
            <div class="border-t border-line pt-4">
              <dt class="font-semibold leading-snug">{benefit.title}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-muted">{benefit.description}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}
  </div>
</section>

<section class="g-section" aria-labelledby="facts-title">
  <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <h2 id="facts-title" class="g-h2">Rp5 juta ini dapat apa saja?</h2>
      <p class="lead mt-5">Semakin besar biayanya, semakin wajar kamu ingin tahu detailnya lebih dulu.</p>
    </div>
    <dl class="border-t border-body lg:col-span-8">
      {programFacts.map((fact) => (
        <div class="grid gap-1 border-b border-line py-4 sm:grid-cols-3 sm:gap-8">
          <dt class="g-label text-muted">{fact.label}</dt>
          <dd class="sm:col-span-2">{tidy(fact.value).replaceAll(' · ', ', ')}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="g-section" aria-labelledby="career-title">
  <div class="shell">
    <h2 id="career-title" class="g-h2">Setelah lulus</h2>
    <ol class="mt-12 grid gap-y-8 border-t border-body sm:grid-cols-2 lg:grid-cols-4">
      {careerPath.map((item, index) => (
        <li class="pt-6 sm:pr-8">
          <span class="g-num text-4xl text-muted" aria-hidden="true">{index + 1}</span>
          <h3 class="g-h3 mt-3">{item.step}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{item.detail}</p>
        </li>
      ))}
    </ol>
    <p class="mt-12 max-w-prose text-lg leading-relaxed">{careerStatement}</p>

    <div class="mt-20 grid gap-10 border-t border-line pt-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h3 class="g-h2">Bukan hanya belajar memperbaiki mobil.</h3>
        <p class="lead mt-5">
          Untuk ayah dan ibu: kami membantu membangun kesiapan kerja, kebiasaan yang terbawa ke pekerjaan pertama, apa pun bengkelnya.
        </p>
        <a href="#konsultasi" data-lead-cta data-source-cta="parents_consultation" class="btn btn-ghost mt-8">
          Konsultasi untuk anak Anda
        </a>
      </div>
      <div class="lg:col-span-7">
        <ul class="grid gap-x-10 gap-y-4 sm:grid-cols-2">
          {parentReadiness.map((item) => <li class="g-node font-semibold leading-snug">{item}</li>)}
        </ul>
        <p class="mt-8 max-w-prose leading-relaxed text-muted">{parentStatement}</p>
      </div>
    </div>
  </div>
</section>

<section class="g-section" aria-labelledby="online-title">
  <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <h2 id="online-title" class="g-h2">Belum bisa ke bengkel? Mulai dari kelas online.</h2>
      <p class="lead mt-5">Kelas video yang bisa dipelajari dari rumah, dibeli satuan.</p>
      <a href="/kelas-online/" class="btn btn-ghost mt-8">Lihat semua kelas online</a>
    </div>
    <ul class="border-t border-body lg:col-span-8">
      {onlineCourses.map((course) => (
        <li class="border-b border-line" {...livePriceAttrs(course.slug, course)}>
          <a href={course.href} class="group flex items-center gap-5 py-5 sm:gap-7">
            <img src={course.cover} alt="" width={course.coverWidth} height={course.coverHeight} loading="lazy" decoding="async" class="h-24 w-24 shrink-0 object-cover sm:h-32 sm:w-32" />
            <span class="min-w-0 flex-1">
              <span class="g-h3 block group-hover:text-accent">{course.name}</span>
              <span class="mt-2 block text-sm leading-relaxed text-muted">{course.summary}</span>
              <span class="mt-3 flex flex-wrap items-baseline gap-x-3">
                <span class="g-num text-2xl">{course.priceDisplay}</span>
                <span class="text-sm text-muted line-through">{course.strikePriceDisplay}</span>
                <span class="text-sm text-muted">{course.priceLabel}</span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="faq" class="g-section scroll-mt-28" aria-labelledby="faq-title">
  <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <h2 id="faq-title" class="g-h2">Pertanyaan yang sering muncul</h2>
      <p class="lead mt-5">Belum terjawab? Tanyakan langsung ke Education Consultant.</p>
      <a href="#konsultasi" data-lead-cta data-source-cta="faq_consultation" class="btn btn-ghost mt-7">Konsultasi Program Gratis</a>
    </div>
    <div class="border-t border-body lg:col-span-8">
      {faqs.map((faq) => (
        <details name="faq" class="group border-b border-line">
          <summary class="flex min-h-11 list-none items-start justify-between gap-6 py-5 text-lg font-semibold leading-snug transition-colors hover:text-accent">
            {faq.question}
            <svg aria-hidden="true" class="mt-1 h-5 w-5 shrink-0 text-muted transition-transform duration-200 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
          </summary>
          <p class="max-w-prose pb-6 leading-relaxed text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section id="consultation" class="g-section" aria-labelledby="consultation-title">
  <span id="cta" class="sr-only" aria-hidden="true"></span>
  <div class="shell grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-16">
    <div class="lg:sticky lg:top-36 lg:col-span-5">
      <h2 id="consultation-title" class="g-h2">Siap membangun skill mekanikmu?</h2>
      <p class="lead mt-6">
        Ceritakan tujuanmu kepada Education Consultant Pitcar Academy. Kami akan membantu merekomendasikan program yang paling sesuai.
      </p>
      <ul class="mt-9 space-y-4">
        {consultationSteps.map((step) => <li class="g-node leading-relaxed text-muted">{step}</li>)}
      </ul>
      <p class="mt-9 border-t border-line pt-6 text-sm text-muted">Batch terdekat Oktober 2026. Basic mulai Rp5.000.000.</p>
    </div>

    <div id="konsultasi" class="scroll-mt-28 lg:col-span-7">
      <div id="lead-form-shell">
        <LeadForm />
      </div>
    </div>
  </div>
</section>

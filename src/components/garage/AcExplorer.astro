---
import { acCases, type GaugeLevel } from '../../data/acCases';
import PartDiagram from './PartDiagram.astro';

interface Props {
  modules: { title: string }[];
  checkout: { href: string; label: string };
}

const { modules, checkout } = Astro.props;

// Needle angle for each zone, in degrees from straight up.
const ANGLE: Record<GaugeLevel, number> = { vakum: -84, 'sangat rendah': -80, rendah: -55, normal: 0, tinggi: 55, 'sangat tinggi': 84 };
const tidy = (text: string) => text.replaceAll(' — ', ', ');
const first = acCases[0];
const client = acCases.map(({ id, label, suspects, low, high }) => ({ id, label, suspects, low, high, lowAngle: ANGLE[low], highAngle: ANGLE[high] }));

const gauges = [
  { key: 'low', name: 'Sisi tekanan rendah', level: first.low },
  { key: 'high', name: 'Sisi tekanan tinggi', level: first.high },
] as const;
---

<div data-ac data-cases={JSON.stringify(client)} class="grid gap-x-10 gap-y-10 lg:grid-cols-12 lg:items-center">
  <div class="min-w-0 lg:col-span-5"><slot /></div>

  <div class="g-stage min-w-0 lg:col-span-7" data-stage>
    <div class="g-car g-poster">
      <PartDiagram id="ac" title="sistem AC mobil" />
    </div>

    <p class="g-loading g-readout" role="status">Memuat model 3D</p>
    <noscript><style>.g-stage .g-car{display:grid}.g-stage .g-loading{display:none}</style></noscript>

    <canvas
      class="g-canvas"
      data-canvas
      tabindex="0"
      aria-label="Model 3D sistem AC mobil. Geser, atau tekan tombol panah, untuk memutar. Setiap komponen juga bisa dipilih lewat tombol di bawah."
    ></canvas>

    <span class="g-bracket g-bracket-tl" aria-hidden="true"></span>
    <span class="g-bracket g-bracket-tr" aria-hidden="true"></span>
    <span class="g-bracket g-bracket-bl" aria-hidden="true"></span>
    <span class="g-bracket g-bracket-br" aria-hidden="true"></span>

    <div class="g-hud g-hud-tl">
      <p class="g-readout g-readout-strong"><span class="g-dot" aria-hidden="true"></span><span data-hud-title>Sistem AC // {first.label}</span></p>
      <p class="g-readout">Sisi rendah: <output data-hud-low>{first.low}</output> // Sisi tinggi: <output data-hud-high class="is-hot">{first.high}</output></p>
      <p class="g-readout" data-hud-legend>Merah: panas, tekanan tinggi</p>
    </div>

    <div class="g-hud g-hud-zoom" data-zoom hidden>
      <button type="button" class="g-hud-btn" data-zoom-in aria-label="Perbesar">
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
      </button>
      <button type="button" class="g-hud-btn" data-zoom-out aria-label="Perkecil">
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M5 12h14"></path></svg>
      </button>
    </div>

    <div class="g-hud g-hud-bl">
      <label class="g-explode g-readout" data-explode hidden>
        <span>Geser untuk membongkar: <output>000%</output></span>
        <input type="range" min="0" max="100" value="0" />
        <span class="g-explode-ends" aria-hidden="true"><span>Terakit</span><span>Terbongkar</span></span>
      </label>
    </div>

    <div class="g-hud g-hud-br">
      <button type="button" class="g-hud-btn" data-run aria-pressed="false" hidden>Jalankan AC</button>
    </div>

    <p class="g-tip g-readout" data-tip hidden></p>
  </div>

  <div class="min-w-0 lg:col-span-12">
  <h2 id="kasus-title" class="g-h3 max-w-[40ch]">Keluhannya selalu sama: kurang dingin. Pilih satu penyebab dan lihat apa yang berubah.</h2>
  <ul class="g-callouts g-chip-row" aria-labelledby="kasus-title">
    {acCases.map((item) => (
      <li>
        <button type="button" class="g-callout g-label" data-case={item.id} aria-pressed={item.id === first.id ? 'true' : 'false'} aria-controls="pembacaan">
          {item.label}
        </button>
      </li>
    ))}
  </ul>

  <div id="pembacaan" class="g-panel mt-8 grid gap-x-10 gap-y-8 py-8 lg:grid-cols-12 lg:py-10">
    <div class="lg:col-span-4">
      <h3 class="g-label text-muted">Bacaan manifold gauge</h3>
      <div class="mt-4 grid grid-cols-2 gap-4">
        {gauges.map((g) => (
          <figure class:list={['g-gauge', g.key === 'high' && 'g-gauge-hot']}>
            <svg viewBox="0 0 160 100" width="160" height="100" aria-hidden="true" focusable="false">
              <path class="g-gauge-arc" d="M16 88A64 64 0 0 1 144 88" />
              <path class="g-gauge-zone" d="M48 32.6A64 64 0 0 1 112 32.6" />
              <path class="g-gauge-tick" d="M16 88h10M144 88h-10M48 32.6l5 8.7M112 32.6l-5 8.7M80 24v10" />
              <g class="g-gauge-needle" data-needle={g.key} style={`--a:${ANGLE[g.level]}deg`}>
                <path d="M80 88V34" />
              </g>
              <rect class="g-gauge-hub" x="75" y="83" width="10" height="10" />
            </svg>
            <figcaption>
              <span class="g-label text-muted">{g.name}</span>
              <span class="g-h3 block" data-level={g.key}>{g.level}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="mt-5 text-sm leading-relaxed text-muted">
        Busur tebal di tengah adalah rentang normal. Ini gambaran pola, bukan angka: tekanan normal berubah mengikuti suhu udara dan tipe mobil.
      </p>
    </div>

    <div aria-live="polite" class="lg:col-span-8">
      {acCases.map((item) => (
        <article data-case-detail={item.id} hidden={item.id !== first.id} class="grid gap-x-10 gap-y-8 lg:grid-cols-8">
          <div class="lg:col-span-5">
            <h3 class="g-h3">{item.label}</h3>
            <p class="mt-3 text-lg leading-relaxed">{item.what}</p>
            <p class="g-node mt-6 leading-relaxed text-muted">{item.question}</p>
          </div>

          <div class="lg:col-span-3">
            {item.suspects.length > 0 && (
              <>
                <h4 class="g-label text-muted">Yang dicurigai</h4>
                <ul class="g-callouts !mt-3">
                  {item.suspects.map((name) => (
                    <li><button type="button" class="g-callout g-label" data-part={name}>{name}</button></li>
                  ))}
                </ul>
              </>
            )}
            <h4 class:list={['g-label text-muted', item.suspects.length > 0 && 'mt-7']}>Dasarnya ada di</h4>
            <p class="mt-2 leading-relaxed">Video {item.video + 1}: {tidy(modules[item.video].title)}</p>
            <a href={checkout.href} data-checkout data-source-cta={`ac_case_${item.id}`} class="btn btn-primary mt-5 w-full">{checkout.label}</a>
          </div>
        </article>
      ))}
    </div>
  </div>

  <details class="g-parts border-t border-line">
    <summary class="g-label flex min-h-11 list-none items-center justify-between gap-6 py-4">
      Lihat semua komponen sistem AC
      <svg aria-hidden="true" class="h-5 w-5 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
    </summary>
    <ul class="g-callouts !mt-0 pb-2" data-part-chips aria-label="Komponen sistem AC"></ul>
    <p class="py-4 text-sm text-muted" data-parts-empty>Daftar komponen muncul setelah model 3D selesai dimuat.</p>
  </details>
  <p class="max-w-prose border-t border-line pt-5 leading-relaxed" data-part-info aria-live="polite" hidden></p>
  </div>
</div>

<script>
  import type { Garage } from '../../scripts/garage/scene';

  interface Case { id: string; label: string; suspects: string[]; low: string; high: string; lowAngle: number; highAngle: number }

  const root = document.querySelector<HTMLElement>('[data-ac]');

  if (root) {
    const cases: Case[] = JSON.parse(root.dataset.cases!);
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const all = <T extends Element>(sel: string) => [...root.querySelectorAll<T>(sel)];
    const stage = q('[data-stage]');
    const canvas = q<HTMLCanvasElement>('[data-canvas]');
    const caseButtons = all<HTMLButtonElement>('[data-case]');
    const details = all<HTMLElement>('[data-case-detail]');
    const hudTitle = q('[data-hud-title]');
    const tip = q('[data-tip]');
    const partList = q('[data-part-chips]');
    const partInfo = q('[data-part-info]');
    const runButton = q<HTMLButtonElement>('[data-run]');
    const explode = q('[data-explode]');
    const slider = explode.querySelector('input')!;
    const percent = explode.querySelector('output')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    let garage: Garage | null = null;
    let subs: { name: string; info: string }[] = [];
    let current = cases[0];

    const indexOf = (name: string) => subs.findIndex((sub) => sub.name === name);

    const setRunning = (on: boolean) => {
      garage?.setRunning(on);
      runButton.setAttribute('aria-pressed', String(on));
      runButton.textContent = on ? 'Hentikan AC' : 'Jalankan AC';
    };

    const showPart = (index: number) => {
      if (index < 0) return;
      garage?.selectSub(index, false);
      all<HTMLButtonElement>('[data-part-chips] button').forEach((b, i) => b.setAttribute('aria-pressed', String(i === index)));
      partInfo.hidden = false;
      partInfo.replaceChildren(
        Object.assign(document.createElement('strong'), { textContent: `${subs[index].name}. ` }),
        subs[index].info,
      );
    };

    const selectCase = (id: string, fromUser: boolean) => {
      current = cases.find((c) => c.id === id)!;
      caseButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.case === id)));
      details.forEach((d) => { d.hidden = d.dataset.caseDetail !== id; });
      hudTitle.textContent = `Sistem AC // ${current.label}`;
      for (const side of ['low', 'high'] as const) {
        q(`[data-needle=${side}]`).style.setProperty('--a', `${side === 'low' ? current.lowAngle : current.highAngle}deg`);
        q(`[data-level=${side}]`).textContent = current[side];
        q(`[data-hud-${side}]`).textContent = current[side];
      }
      // Red means heat. Once a fault is chosen it also marks the suspects, and
      // with the compressor off there is no heat left to mark.
      q('[data-hud-legend]').textContent = !current.suspects.length
        ? 'Merah: panas, tekanan tinggi'
        : id === 'kopling'
          ? 'Merah: komponen yang dicurigai'
          : 'Merah: panas, dan komponen yang dicurigai';
      garage?.setState(id);
      garage?.selectSub(null);
      garage?.mark(current.suspects.map(indexOf).filter((i) => i >= 0));
      partInfo.hidden = true;
      if (!fromUser) return;
      // On a phone the chips scroll sideways; keep the chosen one fully in view.
      caseButtons.find((b) => b.dataset.case === id)?.scrollIntoView({ inline: 'nearest', block: 'nearest' });
      window.dataLayer?.push({ event: 'ac_case_view', case_id: id });
    };

    caseButtons.forEach((b) => b.addEventListener('click', () => selectCase(b.dataset.case!, true)));
    root.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-part]');
      if (button) showPart(indexOf(button.dataset.part!));
    });
    runButton.addEventListener('click', () => setRunning(runButton.getAttribute('aria-pressed') !== 'true'));
    q('[data-zoom-in]').addEventListener('click', () => garage?.zoom(0.82));
    q('[data-zoom-out]').addEventListener('click', () => garage?.zoom(1.22));
    slider.addEventListener('input', () => garage?.setExplode(Number(slider.value) / 100));

    // three.js is the heaviest thing on the page: load it after first paint.
    const boot = async () => {
      const [{ createGarage }, { acSystem }] = await Promise.all([import('../../scripts/garage/scene'), import('../../scripts/garage/ac')]);
      garage = await createGarage(canvas, {
        fuel: 'efi',
        matic: false,
        slot: 'ac',
        custom: acSystem,
        onPick: () => {},
        onOpen: () => {},
        onSub: showPart,
        onHover: (hover) => {
          tip.hidden = !hover;
          if (!hover) return;
          tip.textContent = subs[hover.sub!]?.name ?? '';
          tip.style.left = `${canvas.offsetLeft + hover.x}px`;
          tip.style.top = `${canvas.offsetTop + hover.y}px`;
        },
        onExplode: (t) => {
          const value = Math.round(t * 100);
          percent.textContent = `${String(value).padStart(3, '0')}%`;
          if (document.activeElement !== slider) slider.value = String(value);
        },
      });
      if (!garage) throw new Error('WebGL unavailable');
      subs = garage.openBench(0).subs;
      partList.replaceChildren(...subs.map((sub) => {
        const li = document.createElement('li');
        const b = Object.assign(document.createElement('button'), { type: 'button', className: 'g-callout g-label', textContent: sub.name });
        b.dataset.part = sub.name;
        b.setAttribute('aria-pressed', 'false');
        li.append(b);
        return li;
      }));
      q('[data-parts-empty]').hidden = true;
      stage.dataset.ready = '';
      explode.hidden = runButton.hidden = q('[data-zoom]').hidden = false;
      selectCase(current.id, false);
      if (!reduce.matches) setRunning(true);
    };
    const idle = window.requestIdleCallback ?? ((fn: () => void) => setTimeout(fn, 200));
    idle(() => {
      boot().catch(() => {
        stage.dataset.fallback = '';
        // The line diagram becomes the picture; say so instead of promising a model.
        q('[data-parts-empty]').textContent = 'Model 3D tidak bisa dimuat di perangkat ini. Diagram di atas menunjukkan alur refrigeran yang sama.';
      });
    });
  }
</script>

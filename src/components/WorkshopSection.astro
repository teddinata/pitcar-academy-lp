---
import { facilities } from '../content.config';
---

<section class="band band-ink" aria-labelledby="workshop-title">
  <div class="shell">
    <div class="max-w-3xl">
      <p class="eyebrow text-accent-ink">Lingkungan belajar</p>
      <h2 id="workshop-title" class="display-2 mt-6 text-paper">
        Belajar dengan tools yang digunakan di bengkel.
      </h2>
      <p class="lead mt-5 text-muted-ink">
        Bukan hanya demo. Peserta berlatih memahami prosedur kerja menggunakan
        peralatan yang relevan dengan pekerjaan mekanik sehari-hari.
      </p>
    </div>

    <!-- Editorial grid: one tall frame anchors two wide ones, so the photos
         read as documentation of a real place rather than a gallery widget. -->
    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      <figure class="lg:row-span-2">
        <img
          src="/3.webp"
          alt="Suasana ritme pekerjaan harian di bengkel PITCAR"
          width="720"
          height="1280"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover aspect-[3/4] lg:aspect-auto lg:min-h-[32rem]"
        />
      </figure>
      <figure>
        <img
          src="/1.webp"
          alt="Trainer mendampingi peserta saat praktik pada kendaraan"
          width="1600"
          height="1200"
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full object-cover"
        />
      </figure>
      <figure>
        <img
          src="/2.webp"
          alt="Mekanik bekerja mengikuti standar prosedur bengkel"
          width="1600"
          height="1200"
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full object-cover"
        />
      </figure>
      <figure class="sm:col-span-2">
        <img
          src="/mechanic-practice.webp"
          alt="Peserta Pitcar Academy praktik langsung di area kerja bengkel"
          width="720"
          height="720"
          loading="lazy"
          decoding="async"
          class="aspect-[16/9] w-full object-cover"
        />
      </figure>
    </div>

    <dl class="mt-14 grid gap-x-10 gap-y-8 border-t rule-ink pt-12 sm:grid-cols-2 lg:grid-cols-3">
      {facilities.map((item) => (
        <div>
          <dt class="display-3 text-paper">{item.title}</dt>
          <dd class="mt-2 text-sm leading-relaxed text-muted-ink">{item.description}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

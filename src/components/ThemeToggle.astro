---
// Theme is applied before paint by the inline script in BaseLayout, so this
// button only ever has to reflect and flip what is already on <html>.
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex h-11 w-11 items-center justify-center rounded-sm border border-line text-body transition-colors hover:bg-ground-alt"
  aria-label="Ganti ke mode gelap"
  aria-pressed="false"
>
  <svg aria-hidden="true" data-theme-icon="light" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg aria-hidden="true" data-theme-icon="dark" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = 'pitcar-theme';
  const button = document.getElementById('theme-toggle');
  const sun = document.querySelector<SVGElement>('[data-theme-icon="light"]');
  const moon = document.querySelector<SVGElement>('[data-theme-icon="dark"]');

  function render(isDark: boolean) {
    document.documentElement.classList.toggle('dark', isDark);
    document.getElementById('theme-color')?.setAttribute('content', isDark ? '#0A0A0A' : '#FAFAF9');
    sun?.classList.toggle('hidden', isDark);
    moon?.classList.toggle('hidden', !isDark);
    button?.setAttribute('aria-pressed', String(isDark));
    button?.setAttribute('aria-label', isDark ? 'Ganti ke mode terang' : 'Ganti ke mode gelap');
  }

  render(document.documentElement.classList.contains('dark'));

  button?.addEventListener('click', () => {
    const isDark = !document.documentElement.classList.contains('dark');
    render(isDark);
    try {
      localStorage.setItem(STORAGE_KEY, isDark ? 'dark' : 'light');
    } catch {
      // A blocked storage API must not stop the theme from switching.
    }
  });
</script>

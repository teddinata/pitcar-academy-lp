---
import { trainers } from '../content.config';
---

<section class="band border-t border-line" aria-labelledby="trainers-title">
  <div class="shell">
    <div class="max-w-3xl">
      <p class="eyebrow text-accent">Pengajar</p>
      <h2 id="trainers-title" class="display-2 mt-6">Kamu akan belajar dari siapa?</h2>
      <p class="lead mt-5 text-muted">
        Trainer Pitcar Academy adalah praktisi yang mengerjakan kendaraan customer,
        bukan pengajar yang hanya membaca modul.
      </p>
    </div>

    <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {trainers.map((trainer) => (
        <li class="card flex flex-col">
          {trainer.photo ? (
            <img
              src={trainer.photo}
              alt={`${trainer.name}, ${trainer.role} di Pitcar Academy`}
              width="600"
              height="750"
              loading="lazy"
              decoding="async"
              class="aspect-[4/5] w-full object-cover"
            />
          ) : (
            <div
              class="flex aspect-[4/5] w-full flex-col items-center justify-center gap-3 bg-ground-alt"
              role="img"
              aria-label={`Foto ${trainer.name} belum tersedia`}
            >
              <svg aria-hidden="true" class="h-14 w-14 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <circle cx="12" cy="12" r="3.5"></circle>
                <path d="M8 5.5 9 3h6l1 2.5"></path>
              </svg>
              <span class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">
                Foto menyusul
              </span>
            </div>
          )}

          <div class="flex flex-1 flex-col p-6">
            <h3 class="display-3">{trainer.name}</h3>
            <p class="mt-1.5 text-sm font-semibold text-accent">{trainer.role}</p>
            <ul class="mt-5 space-y-2.5 text-sm leading-relaxed text-muted">
              {trainer.credentials.map((credential) => (
                <li class="flex gap-2.5">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent-fill" aria-hidden="true"></span>
                  {credential}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

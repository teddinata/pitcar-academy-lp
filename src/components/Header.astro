---
import ThemeToggle from './ThemeToggle.astro';
import { announcement } from '../content.config';

const homePrefix = Astro.url.pathname === '/' ? '' : '/';

const navLinks = [
  { href: `${homePrefix}#metode`, label: 'Metode' },
  { href: `${homePrefix}#program`, label: 'Program' },
  { href: `${homePrefix}#perjalanan`, label: 'Perjalanan Belajar' },
  { href: `${homePrefix}#faq`, label: 'FAQ' },
];
const consultationHref = `${homePrefix}#konsultasi`;
---

<header class="fixed inset-x-0 top-0 z-50">
  {announcement.publish && (
    <a
      href={homePrefix + announcement.href}
      data-lead-cta
      data-source-cta="announcement_bar"
      class="group flex min-h-11 flex-wrap items-center justify-center gap-x-2.5 gap-y-1 bg-accent-fill px-4 py-3 text-center text-xs font-bold text-white transition-colors hover:bg-accent-fill-hover sm:text-sm"
    >
      <span class="font-display text-sm font-bold uppercase tracking-wide sm:text-base">{announcement.text}</span>
      <span class="text-white/90">{announcement.urgency}</span>
      <span class="inline-flex items-center gap-1 whitespace-nowrap underline underline-offset-2">
        {announcement.cta}
        <svg aria-hidden="true" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </span>
    </a>
  )}

  <div class="border-b border-line bg-ground/95 backdrop-blur">
    <nav class="shell flex h-16 items-center justify-between gap-6 md:h-20" aria-label="Navigasi utama">
      <a href={homePrefix || '/'} class="flex items-baseline gap-1.5 font-display text-xl font-bold leading-none tracking-tight md:text-2xl">
        <span class="text-body">PITCAR</span><span class="text-accent">ACADEMY</span>
      </a>

      <div class="hidden items-center gap-8 lg:flex">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-semibold text-muted transition-colors hover:text-body"
          >
            {link.label}
          </a>
        ))}
        <ThemeToggle />
        <a href={consultationHref} data-lead-cta data-source-cta="header_desktop" class="btn btn-primary min-h-11 px-5 py-2.5 text-sm">
          Konsultasi Gratis
        </a>
      </div>

      <div class="flex items-center gap-2 lg:hidden">
        <ThemeToggle />
      <button
        id="mobile-menu-btn"
        type="button"
        class="-mr-2 inline-flex h-11 w-11 items-center justify-center text-muted transition-colors hover:text-body lg:hidden"
        aria-label="Buka menu navigasi"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg aria-hidden="true" id="menu-icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
        <svg aria-hidden="true" id="menu-icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
      </div>
    </nav>
  </div>

  <div id="mobile-menu" class="hidden border-b border-line bg-ground lg:hidden">
    <div class="shell space-y-1 py-4">
      {navLinks.map((link) => (
        <a href={link.href} class="mobile-nav-link block py-3 text-base font-semibold text-muted transition-colors hover:text-body">
          {link.label}
        </a>
      ))}
      <a href={consultationHref} data-lead-cta data-source-cta="header_mobile" class="mobile-nav-link btn btn-primary mt-3 w-full">
        Konsultasi Gratis
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu && iconOpen && iconClose) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
    };

    btn.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));

    menu.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        setOpen(false);
        btn.focus();
      }
    });
  }
</script>

---
const homePrefix = Astro.url.pathname === '/' ? '' : '/';

const navLinks = [
  { href: `${homePrefix}#metode`, label: 'Metode' },
  { href: `${homePrefix}#program`, label: 'Program' },
  { href: `${homePrefix}#perjalanan`, label: 'Perjalanan Belajar' },
  { href: `${homePrefix}#faq`, label: 'FAQ' },
];
const consultationHref = `${homePrefix}#konsultasi`;
---

<header class="fixed inset-x-0 top-0 z-50">
  <p class="flex items-center justify-center gap-2.5 border-b border-ink-line bg-ink px-4 py-2.5 text-center text-xs font-semibold text-stone-300 sm:text-sm">
    <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
    Founding Batch 2026 — pendaftaran konsultasi dibuka
  </p>

  <div class="border-b border-ink-line bg-ink/95 backdrop-blur">
    <nav class="shell flex h-16 items-center justify-between gap-6 md:h-20" aria-label="Navigasi utama">
      <a href={homePrefix || '/'} class="flex items-baseline gap-1.5 font-display text-xl font-bold leading-none tracking-tight md:text-2xl">
        <span class="text-paper">PITCAR</span><span class="text-brand-400">ACADEMY</span>
      </a>

      <div class="hidden items-center gap-8 lg:flex">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-semibold text-stone-300 transition-colors hover:text-paper"
          >
            {link.label}
          </a>
        ))}
        <a href={consultationHref} data-lead-cta data-source-cta="header_desktop" class="btn btn-primary min-h-11 px-5 py-2.5 text-sm">
          Konsultasi Gratis
        </a>
      </div>

      <button
        id="mobile-menu-btn"
        type="button"
        class="-mr-2 inline-flex h-11 w-11 items-center justify-center text-stone-300 transition-colors hover:text-paper lg:hidden"
        aria-label="Buka menu navigasi"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg aria-hidden="true" id="menu-icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
        <svg aria-hidden="true" id="menu-icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </nav>
  </div>

  <div id="mobile-menu" class="hidden border-b border-ink-line bg-ink lg:hidden">
    <div class="shell space-y-1 py-4">
      {navLinks.map((link) => (
        <a href={link.href} class="mobile-nav-link block py-3 text-base font-semibold text-stone-200 transition-colors hover:text-paper">
          {link.label}
        </a>
      ))}
      <a href={consultationHref} data-lead-cta data-source-cta="header_mobile" class="mobile-nav-link btn btn-primary mt-3 w-full">
        Konsultasi Gratis
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu && iconOpen && iconClose) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
    };

    btn.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));

    menu.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        setOpen(false);
        btn.focus();
      }
    });
  }
</script>

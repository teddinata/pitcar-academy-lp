---
import { contact } from '../content.config';

// SEO Head Component — Reusable for all pages
interface Props {
  title: string;
  description: string;
  image?: string | URL;
  url?: string | URL;
  type?: 'website' | 'article' | 'profile';
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = '/og-image.jpg',
  url = '/',
  type = 'website',
  structuredData = [],
} = Astro.props;

const siteName = 'Pitcar Academy';
const siteUrl = new URL(Astro.site ?? 'https://academy.pitcar.co.id');
const fullTitle = title.toLowerCase().includes(siteName.toLowerCase())
  ? title
  : `${title} | ${siteName}`;
const fullImage = new URL(image, siteUrl);
const imageExtension = fullImage.pathname.split('.').pop()?.toLowerCase();
const imageType = imageExtension === 'png'
  ? 'image/png'
  : imageExtension === 'webp'
    ? 'image/webp'
    : 'image/jpeg';
const fullUrl = new URL(url, siteUrl);
const organizationId = new URL('/#organization', siteUrl).href;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    '@id': organizationId,
    name: siteName,
    description:
      'Program pelatihan mekanik profesional dengan kurikulum terstruktur, praktik intensif, dan pengalaman di lingkungan bengkel PITCAR.',
    url: siteUrl.href,
    image: fullImage.href,
    telephone: `+${contact.whatsappNumber}`,
    sameAs: [contact.website],
    // Coordinates come from the Maps link itself. No streetAddress is claimed
    // because none has been confirmed — a wrong address is worse than none.
    location: {
      '@type': 'Place',
      name: contact.placeName,
      hasMap: contact.mapsUrl,
      geo: {
        '@type': 'GeoCoordinates',
        latitude: contact.latitude,
        longitude: contact.longitude,
      },
    },
  },
  ...structuredData,
];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={fullUrl.href} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImage.href} />
<meta property="og:image:secure_url" content={fullImage.href} />
<meta property="og:image:type" content={imageType} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Peserta Pitcar Academy belajar langsung di lingkungan bengkel" />
<meta property="og:url" content={fullUrl.href} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="id_ID" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImage.href} />
<meta name="twitter:image:alt" content="Peserta Pitcar Academy belajar langsung di lingkungan bengkel" />

<!-- Structured data is rendered in the document head so crawlers receive valid HTML. -->
{schemas.map((schema) => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
))}

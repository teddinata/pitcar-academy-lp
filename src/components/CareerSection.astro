---
import { careerStatement } from '../content.config';

const path = [
  { step: 'Lulus program', detail: 'Menyelesaikan kelas, praktik, OJT, dan assessment.' },
  { step: 'Sertifikat kelulusan', detail: 'Bukti penyelesaian sesuai program yang diambil.' },
  { step: 'Kesempatan seleksi', detail: 'Peserta dengan performa sesuai kebutuhan dapat mengikuti proses rekrutmen.' },
  { step: 'Karier mekanik', detail: 'Masuk dunia kerja otomotif dengan pengalaman bengkel nyata.' },
];
---

<section class="band border-t border-line" aria-labelledby="career-title">
  <div class="shell">
    <div class="max-w-3xl">
      <p class="eyebrow text-accent">Setelah lulus</p>
      <h2 id="career-title" class="display-2 mt-6 text-body">Career opportunity</h2>
    </div>

    <ol class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {path.map((item, index) => (
        <li class="bg-ground px-6 py-8">
          <span class="font-display text-sm font-semibold uppercase tracking-[0.14em] text-accent">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="display-3 mt-2 text-body">{item.step}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{item.detail}</p>
        </li>
      ))}
    </ol>

    <!-- Worded as an opportunity, not a job guarantee. -->
    <p class="lead mt-12 max-w-prose border-l-2 border-accent-fill pl-6 text-muted">
      {careerStatement}
    </p>
  </div>
</section>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaSection from '../components/CtaSection.astro';
import { faqs } from '../content.config';

const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
}];
---

<BaseLayout
  title="FAQ Program Pelatihan Mekanik | Pitcar Academy"
  description="Jawaban untuk pertanyaan umum seputar program pelatihan mekanik Pitcar Academy: durasi, biaya, metode belajar, sertifikat, dan peluang karier."
  canonical="/faq/"
  structuredData={structuredData}
>
  <section class="band-ink pt-28 pb-16 sm:pt-32 md:pt-40 md:pb-20">
    <div class="shell max-w-3xl">
      <p class="eyebrow text-accent-ink">Pusat bantuan</p>
      <h1 class="display-1 mt-6 text-paper">Pertanyaan umum</h1>
      <p class="lead mt-6 text-muted-ink">
        Durasi, biaya, metode belajar, sertifikat, dan peluang karier — dijawab
        selengkap mungkin sebelum kamu memutuskan.
      </p>
    </div>
  </section>

  <FaqSection faqs={faqs} />
  <CtaSection />
</BaseLayout>

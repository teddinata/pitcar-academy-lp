---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { digitalCourse as c, digitalFaqs, packages } from '../content.config';

// Wireframe. Structure is settled, content is not — every figure below is a
// placeholder until materi, harga, and a delivery platform are decided.
// Kept out of the sitemap and marked noindex until `c.ready` is true.
const professional = packages.find((p) => p.id === 'professional');
---

<BaseLayout
  title="Kelas Online Fundamental Otomotif | Pitcar Academy"
  description="Materi fundamental otomotif yang bisa dipelajari dari rumah, disusun oleh trainer yang mengerjakan kendaraan customer setiap hari."
  canonical="/kelas-online/"
  noindex={!c.ready}
>
  {!c.ready && (
    <div class="bg-amber-100 px-4 py-3 pt-32 text-center text-sm font-semibold text-amber-950 md:pt-40">
      Wireframe — struktur halaman, isi masih placeholder. Belum terindeks dan tidak masuk sitemap.
    </div>
  )}

  <!-- 1. HERO — hasil belajar, harga, dan masa akses langsung terlihat -->
  <section class="band pt-10 md:pt-14" aria-labelledby="course-title">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
        <div class="lg:col-span-6">
          <p class="eyebrow">{c.eyebrow}</p>
          <h1 id="course-title" class="display-1 mt-6 max-w-[16ch]">{c.headline}</h1>
          <p class="lead mt-6 max-w-prose">{c.subheadline}</p>

          <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 border-y border-line py-5 text-sm">
            <div><dt class="text-muted">Durasi</dt><dd class="font-semibold">{c.totalDuration}</dd></div>
            <div><dt class="text-muted">Pelajaran</dt><dd class="font-semibold">{c.totalLessons} video</dd></div>
            <div><dt class="text-muted">Akses</dt><dd class="font-semibold">{c.access}</dd></div>
          </dl>

          <div class="mt-8 flex flex-wrap items-baseline gap-x-3">
            <span class="font-display text-4xl font-bold leading-none">{c.price}</span>
            {c.strikePrice && <span class="text-lg text-muted line-through">{c.strikePrice}</span>}
          </div>

          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <!-- Checkout is not wired: payment gateway is outside current scope. -->
            <button type="button" class="btn btn-primary" disabled aria-describedby="checkout-note">
              Ambil kelas — akses langsung
            </button>
            <a href="#kurikulum" class="btn btn-ghost">Lihat kurikulum</a>
          </div>
          <p id="checkout-note" class="mt-3 text-xs text-muted">
            Tombol beli belum aktif — menunggu payment gateway dan materi final.
          </p>
        </div>

        <!-- Product preview: the single most important asset on this page. -->
        <div class="lg:col-span-6">
          <div class="flex aspect-video w-full flex-col items-center justify-center gap-3 border border-line bg-ground-alt" role="img" aria-label="Cuplikan materi kelas belum tersedia">
            <svg aria-hidden="true" class="h-12 w-12 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m10 9 5 3-5 3z"></path></svg>
            <span class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Cuplikan materi menyusul</span>
          </div>
          <p class="mt-3 text-xs text-muted">
            Ganti dengan rekaman layar pelajaran asli. Untuk produk digital, inilah yang paling menentukan konversi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. OUTCOME — apa yang bisa dilakukan setelah selesai -->
  <section class="band band-alt border-t border-line" aria-labelledby="outcome-title">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">Hasil belajar</p>
        <h2 id="outcome-title" class="display-2 mt-6">Setelah kelas ini, kamu bisa:</h2>
      </div>
      <ul class="divide-y divide-line border-y border-line lg:col-span-7">
        {c.outcomes.map((o) => (
          <li class="flex items-start gap-4 py-5">
            <svg aria-hidden="true" class="mt-1 h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span class="text-lg leading-snug">{o}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. KURIKULUM — modul, jumlah pelajaran, durasi, dan satu modul gratis -->
  <section id="kurikulum" class="band border-t border-line scroll-mt-28" aria-labelledby="curriculum-title">
    <div class="shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Kurikulum</p>
        <h2 id="curriculum-title" class="display-2 mt-6">{c.modules.length} modul, {c.totalDuration}</h2>
        <p class="lead mt-5">Satu modul dibuka gratis supaya kamu bisa menilai materinya sebelum membeli.</p>
      </div>

      <ol class="mt-12 border-t border-line">
        {c.modules.map((m, i) => (
          <li class="grid gap-2 border-b border-line py-5 sm:grid-cols-12 sm:items-baseline sm:gap-6">
            <span class="font-display text-sm font-semibold uppercase tracking-[0.14em] text-accent sm:col-span-1">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="display-3 sm:col-span-6">{m.title}</h3>
            <span class="text-sm text-muted sm:col-span-3">{m.lessons} pelajaran · {m.duration}</span>
            <span class="sm:col-span-2 sm:text-right">
              {m.free && (
                <span class="inline-block bg-accent-fill px-2 py-1 text-[0.6875rem] font-bold uppercase tracking-wider text-white">Gratis</span>
              )}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. YANG DIDAPAT — masa akses, perangkat, sertifikat, dukungan -->
  <section class="band band-alt border-t border-line" aria-labelledby="includes-title">
    <div class="shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Yang didapat</p>
        <h2 id="includes-title" class="display-2 mt-6">Sekali beli, ini yang kamu terima.</h2>
      </div>
      <dl class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {c.includes.map((item) => (
          <div>
            <dt class="display-3">{item.title}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-muted">{item.description}</dd>
          </div>
        ))}
      </dl>

      <ul class="mt-12 flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-8 text-sm text-muted">
        {c.requirements.map((r) => (
          <li class="flex items-center gap-2">
            <span class="h-1 w-1 shrink-0 rounded-full bg-accent-fill" aria-hidden="true"></span>{r}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. HARGA — checkout, bukan form konsultasi -->
  <section class="band border-t border-line" aria-labelledby="price-title">
    <div class="shell">
      <div class="mx-auto max-w-2xl border border-line bg-surface p-8 text-center sm:p-12">
        <p class="eyebrow justify-center">Investasi</p>
        <h2 id="price-title" class="display-2 mt-6">{c.price}</h2>
        <p class="mt-3 text-muted">{c.access} · {c.totalLessons} pelajaran · {c.totalDuration}</p>

        <button type="button" class="btn btn-primary mt-8 w-full" disabled>
          Ambil kelas — akses langsung
        </button>
        <p class="mt-3 text-xs text-muted">Checkout menyusul setelah payment gateway tersedia.</p>

        {c.guarantee && (
          <p class="mt-6 flex items-center justify-center gap-2 border-t border-line pt-6 text-sm text-muted">
            <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 4v5c0 4-3 7-7 9-4-2-7-5-7-9V7z"></path></svg>
            {c.guarantee}
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- 6. FAQ — objection khas digital, bukan salinan halaman offline -->
  <FaqSection faqs={digitalFaqs} />

  <!-- 7. TANGGA — mengarah ke program offline, bukan bersaing dengannya -->
  <section class="band border-t border-line" aria-labelledby="ladder-title">
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
        <div class="lg:col-span-7">
          <p class="eyebrow">Langkah berikutnya</p>
          <h2 id="ladder-title" class="display-2 mt-6">Sudah paham dasarnya? Saatnya pegang kuncinya.</h2>
          <p class="lead mt-5 max-w-prose">
            Kelas online membangun pemahaman. Praktik pada kendaraan sungguhan, OJT di bengkel
            yang beroperasi, dan assessment kompetensi hanya ada di program offline.
          </p>
        </div>
        <div class="lg:col-span-5">
          <div class="border border-line bg-surface p-6 sm:p-8">
            <p class="eyebrow">Program offline</p>
            <h3 class="display-3 mt-4">{professional?.name}</h3>
            <p class="mt-3 text-sm text-muted">{professional?.subtitle}</p>
            <p class="mt-5 font-display text-3xl font-bold leading-none">{professional?.priceDisplay}</p>
            <a href="/#program" class="btn btn-primary mt-6 w-full">Lihat program offline</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

---
import LearnShell from '../../components/learn/LearnShell.astro';

const kinds = [
  { value: 'topic', label: 'Usul materi' },
  { value: 'feedback', label: 'Masukan' },
  { value: 'problem', label: 'Kendala' },
];
---

<LearnShell title="Masukan">
  <div data-requests>
    <h1 class="g-h2">Masukan</h1>
    <p class="lead mt-4 max-w-prose">Usulkan materi, beri masukan, atau laporkan kendala. Tim Pitcar Academy membalas di halaman ini.</p>

    <div class="mt-10 grid gap-14 lg:grid-cols-12 lg:gap-14">
      <section class="min-w-0 lg:col-span-5" aria-labelledby="send-title">
        <h2 id="send-title" class="g-h3">Kirim pesan</h2>
        <form class="mt-5 flex flex-col gap-6 border-t border-body pt-6" novalidate data-request-form>
          <fieldset>
            <legend class="text-sm font-semibold">Jenis pesan</legend>
            <div class="mt-2 grid grid-cols-3 gap-2">
              {kinds.map((kind) => (
                <label class="learn-choice">
                  <input type="radio" name="kind" value={kind.value} />
                  <span class="g-label">{kind.label}</span>
                </label>
              ))}
            </div>
            <p class="learn-error mt-2" data-field-error="kind" role="alert" hidden></p>
          </fieldset>

          <div class="flex flex-col gap-1.5">
            <label for="req-course" class="text-sm font-semibold">Tentang kelas</label>
            <select id="req-course" name="course" class="learn-input" aria-describedby="req-course-err">
              <option value="">Umum, bukan kelas tertentu</option>
            </select>
            <p id="req-course-err" class="learn-error" data-field-error="course" hidden></p>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="req-body" class="text-sm font-semibold">Pesan</label>
            <textarea id="req-body" name="body" rows="6" maxlength="2000" required class="learn-input" aria-describedby="req-body-hint req-body-err"></textarea>
            <p id="req-body-hint" class="text-sm text-muted" data-body-hint>Pilih jenis pesan dulu. Minimal 10 karakter.</p>
            <p id="req-body-err" class="learn-error" data-field-error="body" hidden></p>
          </div>

          <p class="learn-error" data-field-error="form" role="alert" hidden></p>
          <div>
            <button type="submit" class="btn btn-primary w-full sm:w-auto" data-request-submit>Kirim pesan</button>
          </div>
          <p class="text-sm" data-request-done role="status" tabindex="-1" hidden>Pesan terkirim. Balasan tim muncul di daftar pesan.</p>
        </form>
      </section>

      <section class="min-w-0 lg:col-span-7" aria-labelledby="history-title">
        <h2 id="history-title" class="g-h3">Pesan yang sudah dikirim</h2>

        <p class="mt-5 text-muted" data-view="loading" aria-live="polite">Memuat pesanmu.</p>

        <div class="mt-5" data-view="error" role="alert" hidden>
          <p data-error-text></p>
          <div class="mt-4"><button type="button" class="btn btn-ghost" data-retry>Muat ulang daftar</button></div>
        </div>

        <p class="mt-5 max-w-prose border-t border-body pt-5 text-muted" data-view="empty" hidden>Belum ada pesan. Pesan yang kamu kirim, beserta balasan tim, muncul di sini.</p>

        <ol class="mt-5 border-t border-body" data-view="list" data-list hidden></ol>
      </section>
    </div>
  </div>

  <template id="request-row">
    <li class="border-b border-line py-6">
      <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm text-muted">
        <span class="g-label text-body" data-kind></span>
        <span data-course></span>
        <span data-date></span>
      </p>
      <p class="mt-2 max-w-prose whitespace-pre-line break-words" data-body></p>
      <p class="mt-3 text-sm text-muted">Status: <strong class="font-semibold text-body" data-status></strong></p>
      <div class="g-node mt-5 max-w-prose" data-reply hidden>
        <p class="text-sm text-muted" data-reply-meta></p>
        <p class="mt-1 whitespace-pre-line break-words" data-reply-text></p>
      </div>
    </li>
  </template>
</LearnShell>

<script>
  import { api, ApiError, requireSession } from '../../scripts/learn/api';

  type Kind = 'topic' | 'feedback' | 'problem';
  type Row = {
    id: number;
    kind: Kind;
    course: { slug: string; title: string } | null;
    body: string;
    status: 'new' | 'reviewing' | 'done';
    reply: string | null;
    replied_at: string | null;
    created_at: string;
  };

  const kindLabel: Record<Kind, string> = { topic: 'Usul materi', feedback: 'Masukan', problem: 'Kendala' };
  const statusLabel = { new: 'Terkirim, belum dibaca', reviewing: 'Sedang ditinjau', done: 'Selesai' };
  const hints: Record<Kind, string> = {
    topic: 'Tulis materi atau kasus yang ingin dibahas, misalnya gejala tertentu atau jenis mobil. Minimal 10 karakter.',
    feedback: 'Ceritakan apa yang sudah membantu dan apa yang masih kurang. Minimal 10 karakter.',
    problem: 'Sebutkan video atau halaman yang bermasalah, perangkat yang dipakai, dan apa yang terjadi. Minimal 10 karakter.',
  };

  const root = document.querySelector<HTMLElement>('[data-requests]')!;
  const show = (view: string) => root.querySelectorAll<HTMLElement>('[data-view]').forEach((el) => (el.hidden = el.dataset.view !== view));
  const list = root.querySelector<HTMLElement>('[data-list]')!;
  const template = document.querySelector<HTMLTemplateElement>('#request-row')!;
  const form = root.querySelector<HTMLFormElement>('[data-request-form]')!;
  const select = form.querySelector<HTMLSelectElement>('[name="course"]')!;
  const textarea = form.querySelector<HTMLTextAreaElement>('[name="body"]')!;
  const kinds = [...form.querySelectorAll<HTMLInputElement>('input[name="kind"]')];
  const submit = form.querySelector<HTMLButtonElement>('[data-request-submit]')!;
  const done = form.querySelector<HTMLElement>('[data-request-done]')!;
  const date = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
  const wanted = new URLSearchParams(location.search).get('k') ?? '';

  function row(item: Row): Node {
    const node = template.content.cloneNode(true) as DocumentFragment;
    const q = <T extends HTMLElement>(sel: string) => node.querySelector<T>(sel)!;
    q('[data-kind]').textContent = kindLabel[item.kind];
    q('[data-course]').textContent = item.course?.title ?? 'Umum';
    q('[data-date]').textContent = date.format(new Date(item.created_at));
    q('[data-body]').textContent = item.body;
    q('[data-status]').textContent = statusLabel[item.status];
    if (item.reply) {
      q('[data-reply]').hidden = false;
      q('[data-reply-meta]').textContent = 'Balasan tim' + (item.replied_at ? ', ' + date.format(new Date(item.replied_at)) : '');
      q('[data-reply-text]').textContent = item.reply;
    }
    return node;
  }

  async function load() {
    show('loading');
    try {
      const { requests } = await api<{ requests: Row[] }>('/learn/requests');
      list.replaceChildren(...requests.map(row));
      show(requests.length ? 'list' : 'empty');
    } catch (e) {
      if (e instanceof ApiError && e.status === 401) return;
      root.querySelector('[data-error-text]')!.textContent = e instanceof ApiError ? e.message : 'Daftar pesan tidak bisa dimuat.';
      show('error');
    }
  }

  // The class picker comes from the same call as the header name.
  async function loadCourses() {
    try {
      const data = await api<{ student: { name: string }; courses: { slug: string; title: string }[] }>('/learn/courses');
      document.querySelector('[data-student-name]')!.textContent = data.student.name;
      select.append(...data.courses.map((c) => new Option(c.title, c.slug, false, c.slug === wanted)));
    } catch {
      // Without the list the message is sent as a general one.
    }
  }

  function fieldError(field: string, message: string | null) {
    const el = form.querySelector<HTMLElement>(`[data-field-error="${field}"]`)!;
    el.textContent = message ?? '';
    el.hidden = !message;
    form.querySelector(`[name="${field}"]:not([type="radio"])`)?.setAttribute('aria-invalid', String(Boolean(message)));
  }

  form.addEventListener('input', (event) => {
    done.hidden = true;
    const target = event.target as HTMLInputElement;
    if (target.name === 'body' || target.name === 'course') fieldError(target.name, null);
    if (target.name === 'kind') {
      fieldError('kind', null);
      form.querySelector('[data-body-hint]')!.textContent = hints[target.value as Kind];
    }
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    done.hidden = true;
    const kind = kinds.find((k) => k.checked)?.value;
    const body = textarea.value.trim();
    fieldError('kind', kind ? null : 'Pilih jenis pesan.');
    fieldError('body', body.length >= 10 ? null : body ? 'Pesan minimal 10 karakter, supaya tim kami paham maksudnya.' : 'Tulis pesanmu dulu.');
    fieldError('course', null);
    fieldError('form', null);
    if (!kind) return kinds[0].focus();
    if (body.length < 10) return textarea.focus();

    submit.disabled = true;
    submit.textContent = 'Mengirim';
    try {
      const res = await api<{ request: Row }>('/learn/requests', { method: 'POST', body: { kind, course: select.value || null, body } });
      list.prepend(row(res.request));
      show('list');
      textarea.value = '';
      done.hidden = false;
      done.focus();
    } catch (e) {
      if (e instanceof ApiError && e.errors) {
        for (const field of ['kind', 'course', 'body']) if (e.errors[field]) fieldError(field, e.errors[field][0]);
      } else {
        fieldError('form', e instanceof ApiError ? (e.status === 429 ? 'Terlalu sering. Tunggu satu menit, lalu coba lagi.' : e.message) : 'Pesan tidak terkirim. Coba lagi.');
      }
    } finally {
      submit.disabled = false;
      submit.textContent = 'Kirim pesan';
    }
  });

  root.querySelector('[data-retry]')!.addEventListener('click', load);

  if (requireSession()) {
    loadCourses();
    load();
  }
</script>

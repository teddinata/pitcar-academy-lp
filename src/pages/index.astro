---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import AboutSection from '../components/AboutSection.astro';
import AdvantageSection from '../components/AdvantageSection.astro';
import DifferentiatorSection from '../components/DifferentiatorSection.astro';
import PackagesSection from '../components/PackagesSection.astro';
import CareerPathSection from '../components/CareerPathSection.astro';
import TargetAudienceSection from '../components/TargetAudienceSection.astro';
import EcosystemGallerySection from '../components/EcosystemGallerySection.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaSection from '../components/CtaSection.astro';
import { faqs, packages } from '../content.config';

const site = Astro.site ?? new URL('https://academy.pitcar.co.id');
const pageUrl = new URL('/', site).href;
const packagesUrl = new URL('#packages', pageUrl).href;
const consultationUrl = new URL('#konsultasi', pageUrl).href;
const organizationId = new URL('/#organization', site).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Program Pelatihan Mekanik Pitcar Academy',
    url: pageUrl,
    itemListElement: packages.map((pkg, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Course',
        name: `${pkg.level} — ${pkg.name}`,
        description: pkg.description,
        url: packagesUrl,
        provider: { '@id': organizationId },
        offers: {
          '@type': 'Offer',
          price: pkg.price,
          priceCurrency: 'IDR',
          availability: 'https://schema.org/LimitedAvailability',
          url: consultationUrl,
        },
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<BaseLayout
  title="Kursus Mekanik dengan Praktik Bengkel Nyata | Pitcar Academy"
  description="Pelatihan mekanik dengan praktik intensif dan 2 bulan OJT di ekosistem bengkel PITCAR. Konsultasikan program yang cocok untukmu."
  canonical="/"
  preloadImage="/mechanic-hero.webp"
  structuredData={structuredData}
>
  <HeroSection />
  <AboutSection />
  <AdvantageSection />
  <DifferentiatorSection />
  <PackagesSection />
  <CareerPathSection />
  <TargetAudienceSection />
  <EcosystemGallerySection />
  <FaqSection faqs={faqs} />
  <CtaSection />
</BaseLayout>

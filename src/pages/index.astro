---
import BaseLayout from '../layouts/BaseLayout.astro';
import CarExplorer from '../components/garage/CarExplorer.astro';
import GarageStory from '../components/garage/GarageStory.astro';
import GarageOffer from '../components/garage/GarageOffer.astro';
import '../styles/garage.css';
import { faqs, packages } from '../content.config';

const site = Astro.site ?? new URL('https://academy.pitcar.co.id');
const pageUrl = new URL('/', site).href;
const programsUrl = new URL('#program', pageUrl).href;
const consultationUrl = new URL('#konsultasi', pageUrl).href;
const organizationId = new URL('/#organization', site).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Program Pelatihan Mekanik Pitcar Academy',
    url: pageUrl,
    itemListElement: packages.map((pkg, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Course',
        name: `${pkg.level} — ${pkg.name}`,
        description: pkg.description,
        url: programsUrl,
        provider: { '@id': organizationId },
        offers: {
          '@type': 'Offer',
          price: pkg.price,
          priceCurrency: 'IDR',
          availability: 'https://schema.org/LimitedAvailability',
          url: consultationUrl,
        },
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<BaseLayout
  title="Kursus Mekanik dengan Praktik Bengkel Nyata | Pitcar Academy"
  description="Pelatihan mekanik dengan praktik intensif dan 2 bulan OJT di ekosistem bengkel PITCAR. Konsultasikan program yang cocok untukmu."
  canonical="/"
  world="garage"
  header={{
    links: [
      { href: '#garasi', label: 'Komponen' },
      { href: '#program', label: 'Program' },
      { href: '#perjalanan', label: 'Perjalanan Belajar' },
      { href: '/kelas-online/', label: 'Kelas Online' },
      { href: '#faq', label: 'FAQ' },
    ],
  }}
  structuredData={structuredData}
>
  <CarExplorer />
  <GarageStory />
  <GarageOffer />
</BaseLayout>

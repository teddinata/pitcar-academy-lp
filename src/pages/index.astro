---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import TrustNumbersSection from '../components/TrustNumbersSection.astro';
import ProblemSection from '../components/ProblemSection.astro';
import MethodSection from '../components/MethodSection.astro';
import CapabilitiesSection from '../components/CapabilitiesSection.astro';
import WorkshopSection from '../components/WorkshopSection.astro';
import TrainersSection from '../components/TrainersSection.astro';
import JourneySection from '../components/JourneySection.astro';
import PackagesSection from '../components/PackagesSection.astro';
import FoundingBatchSection from '../components/FoundingBatchSection.astro';
import CareerSection from '../components/CareerSection.astro';
import ParentsSection from '../components/ParentsSection.astro';
import ProgramFactsSection from '../components/ProgramFactsSection.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaSection from '../components/CtaSection.astro';
import { faqs, packages } from '../content.config';

const site = Astro.site ?? new URL('https://academy.pitcar.co.id');
const pageUrl = new URL('/', site).href;
const programsUrl = new URL('#program', pageUrl).href;
const consultationUrl = new URL('#konsultasi', pageUrl).href;
const organizationId = new URL('/#organization', site).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Program Pelatihan Mekanik Pitcar Academy',
    url: pageUrl,
    itemListElement: packages.map((pkg, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Course',
        name: `${pkg.level} — ${pkg.name}`,
        description: pkg.description,
        url: programsUrl,
        provider: { '@id': organizationId },
        offers: {
          '@type': 'Offer',
          price: pkg.price,
          priceCurrency: 'IDR',
          availability: 'https://schema.org/LimitedAvailability',
          url: consultationUrl,
        },
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<BaseLayout
  title="Kursus Mekanik dengan Praktik Bengkel Nyata | Pitcar Academy"
  description="Pelatihan mekanik dengan praktik intensif dan 2 bulan OJT di ekosistem bengkel PITCAR. Konsultasikan program yang cocok untukmu."
  canonical="/"
  preloadImage="/mechanic-hero.webp"
  structuredData={structuredData}
>
  {/* Dark and light bands alternate so a long page keeps a readable rhythm
      without needing extra colour or decoration. */}
  <HeroSection />
  <TrustNumbersSection />
  <ProblemSection />
  <MethodSection />
  <CapabilitiesSection />
  <WorkshopSection />
  <TrainersSection />
  <JourneySection />
  <PackagesSection />
  <FoundingBatchSection />
  <CareerSection />
  <ParentsSection />
  <ProgramFactsSection />
  <FaqSection faqs={faqs} />
  <CtaSection />
</BaseLayout>

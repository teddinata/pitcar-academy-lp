---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import AcExplorer from '../components/garage/AcExplorer.astro';
import AcDeviceMockup from '../components/AcDeviceMockup.astro';
import SalesPopup from '../components/SalesPopup.astro';
import ClassmateCount from '../components/ClassmateCount.astro';
import '../styles/garage.css';
import { acCourse as c, acFaqs, contact, trustNumbers } from '../content.config';

// Same shape as the inspection sales page: every buy button goes straight to
// the checkout form, and the page has no exits except that button.
const checkoutLabel = `Beli kelas ini, ${c.priceDisplay}`;

// The shared content file separates clauses with a long dash; this page sets
// them with a comma instead of editing copy other pages use.
const tidy = (text: string) => text.replaceAll(' — ', ', ');
const checkoutAttrs = { href: c.checkoutUrl, 'data-checkout': '' };

const workshopNumbers = trustNumbers.filter((n) => n.publish);

const site = Astro.site ?? new URL('https://academy.pitcar.co.id');
const pageUrl = new URL('/kelas-online-ac/', site).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: c.name,
    description: `${c.subheadline} ${c.subheadlineNote}`,
    url: pageUrl,
    image: new URL('/kelas-ac/og.jpg', site).href,
    inLanguage: 'id',
    provider: { '@id': new URL('/#organization', site).href },
    offers: {
      '@type': 'Offer',
      price: String(c.price),
      priceCurrency: 'IDR',
      availability: 'https://schema.org/InStock',
      category: 'Paid',
      url: pageUrl,
    },
    // No courseWorkload: Google expects an ISO 8601 duration there and the
    // video durations are not known. Omitted rather than invented.
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'Online',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: acFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<BaseLayout
  livePrice={{ slug: 'kelas-online-ac', course: c }}
  title={`${c.name}, ${c.priceDisplay} | Pitcar Academy`}
  description={`Kelas online dasar AC mobil: cara kerja komponen, pemeriksaan dengan manifold gauge, troubleshooting elektrikal, dan cuci AC tanpa bongkar. 4 video, modul PDF, akses selamanya. ${c.priceLabel} ${c.priceDisplay}.`}
  canonical="/kelas-online-ac/"
  image="/kelas-ac/og.jpg"
  imageAlt="Kelas Dasar Pemeriksaan & Perawatan AC Mobil: mekanik PITCAR bersedekap di bengkel, belajar sistem kerja AC, pemeriksaan, troubleshooting, sampai cuci AC tanpa bongkar."
  structuredData={structuredData}
  world="garage"
  bare
  ownThemeToggle
  floatingCta={{ href: c.checkoutUrl, label: checkoutLabel, sourceCta: 'ac_floating', icon: false, checkout: true }}
>
  <section class="pt-6 pb-20 sm:pt-8 lg:pb-28" aria-labelledby="hero-title">
    <div class="shell">
      <div class="mb-7 flex items-center justify-between gap-4 border-b border-line pb-3 font-display text-xl font-bold uppercase sm:mb-10 lg:mb-14">
        <span>Pitcar <span class="text-accent">Academy</span></span>
        <span class="flex items-center gap-3">
          <span class="g-label text-muted">Kelas online</span>
          <ThemeToggle />
        </span>
      </div>
      <AcExplorer modules={c.modules} checkout={{ href: c.checkoutUrl, label: `Buka kelasnya, ${c.priceDisplay}` }}>
        <h1 id="hero-title" class="g-h2 !text-[clamp(2.5rem,5vw,3.75rem)]">{c.headline}</h1>        {/* On a phone the lead waits under the simulator, so the machine makes the first screen. */}
        <p class="lead mt-5 max-w-prose max-sm:hidden">{c.subheadline}</p>
        <p slot="after" class="lead max-w-prose sm:hidden">{c.subheadline}</p>

        <div class="mt-7 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="g-num text-5xl">{c.priceDisplay}</span>
          <span class="text-lg text-muted line-through">{c.strikePriceDisplay}</span>
          <span class="text-sm font-semibold text-accent">{c.priceLabel}, hemat {c.savingsDisplay}</span>
        </div>
        <p class="mt-2 text-sm text-muted">Sekali bayar. Akses selamanya, langsung terbuka setelah pembayaran.</p>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row [&>a]:whitespace-nowrap">
          <a {...checkoutAttrs} data-source-cta="ac_hero" class="btn btn-primary">{checkoutLabel}</a>
          {/* On a phone the simulator is the way into the page; this link only pushed it under the fold. */}
          <a href="#isi-kelas" class="btn btn-ghost max-sm:hidden">Lihat isi kelas</a>
        </div>
        <ClassmateCount slug="kelas-online-ac" count={c.students} class="mt-4" />
      </AcExplorer>
    </div>
  </section>

  <section class="g-section" aria-labelledby="problem-title">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2 id="problem-title" class="g-h2">Tanpa dasar pemeriksaan, yang dilakukan adalah menebak.</h2>
        <p class="lead mt-5 max-w-prose">
          Penyebabnya bisa kompresor, tekanan refrigeran, kelistrikan, atau sekadar evaporator yang kotor.
          Dan tebakan paling umum adalah tambah freon.
        </p>
      </div>
      <div class="grid border-t border-body sm:grid-cols-2 lg:col-span-7">
        <div class="border-b border-line py-7 sm:border-b-0 sm:border-r sm:pr-8">
          <h3 class="g-h3 text-muted">Tanpa dasar: kurang dingin? Tambah freon.</h3>
          <ul class="mt-6 space-y-2.5 text-muted">
            <li class="g-node leading-relaxed">Menebak penyebab dari satu gejala</li>
            <li class="g-node leading-relaxed">Membongkar bagian yang sebenarnya tidak bermasalah</li>
            <li class="g-node leading-relaxed">Tidak tahu angka normal di manifold gauge</li>
          </ul>
        </div>
        <div class="py-7 sm:pl-8">
          <h3 class="g-h3">Dengan kelas ini: {c.tagline.toLowerCase()}</h3>
          <ul class="mt-6 space-y-2.5">
            <li class="g-node leading-relaxed">Tahu fungsi dan letak tiap komponen AC</li>
            <li class="g-node leading-relaxed">Membaca manifold gauge dan gejala elektrikal</li>
            <li class="g-node leading-relaxed">Membersihkan blower, evaporator, dan kondensor tanpa bongkar</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="isi-kelas" class="g-section scroll-mt-10" aria-labelledby="modules-title">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-10">
          <h2 id="modules-title" class="g-h2">Empat video, satu urutan kerja yang runtut.</h2>
          <p class="lead mt-5">
            Dari mengenal komponen sampai cuci AC tanpa bongkar, dengan studi kasus dari pekerjaan bengkel.
            Dibuat untuk ditonton sebelum, dan diputar ulang saat, kamu praktik.
          </p>
          <div class="mt-10 max-w-md">
            <AcDeviceMockup
              modules={c.modules.map((m) => ({ title: tidy(m.title) }))}
              alt="Kelas Dasar Pemeriksaan & Perawatan AC Mobil diputar di laptop dan HP: poster kelas dengan mekanik PITCAR, dan daftar empat video dari mengenal komponen AC sampai cuci AC tanpa bongkar."
            />
          </div>
        </div>
      </div>
      <ol class="border-t border-body lg:col-span-7">
        {c.modules.map((m, i) => (
          <li class="flex gap-6 border-b border-line py-7">
            <span class="g-num w-12 shrink-0 text-5xl text-muted" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="g-h3">{tidy(m.title)}</h3>
              <p class="mt-2 max-w-prose leading-relaxed text-muted">{tidy(m.description)}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="g-section" aria-labelledby="pdf-title">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="lg:col-span-3">
        <img
          src="/kelas-ac/modul-pdf.webp"
          width="188"
          height="214"
          loading="lazy"
          decoding="async"
          alt="Sampul Modul Pendamping AC Mobil dari Pitcar Academy, dengan ilustrasi kompresor dan komponen AC."
          class="w-48 lg:w-full"
        />
      </div>
      <div class="lg:col-span-9">
        <h2 id="pdf-title" class="g-h2">Satu PDF untuk dibuka saat tanganmu di kap mesin.</h2>
        <p class="lead mt-5 max-w-prose">{c.pdf.summary}</p>
        <ul class="mt-8 grid gap-x-10 gap-y-3 border-t border-body pt-6 sm:grid-cols-2">
          {c.pdf.contents.map((item) => <li class="g-node leading-relaxed">{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="g-section" aria-labelledby="proof-title">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-7">
        <h2 id="proof-title" class="g-h2">Disusun mekanik PITCAR Service, bengkel spesialis tune up dan AC.</h2>
        <p class="lead mt-5 max-w-prose">
          Materinya diambil dari cara kerja yang dipakai mekanik saat menangani AC mobil customer:
          apa yang diperiksa lebih dulu, angka apa yang dibaca, dan kapan sebuah gejala berarti
          masalah di tempat lain.
        </p>
      </div>
      <div class="lg:col-span-5">
        <p class="g-h3">{tidy(contact.placeName)}</p>
        <dl class="mt-5 border-t border-body">
          {workshopNumbers.map((n) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-line py-3.5">
              <dt class="text-muted">{n.label}</dt>
              <dd class="g-num text-3xl">{n.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section id="cara-belajar" class="g-section scroll-mt-10" aria-labelledby="steps-title">
    <div class="shell">
      <h2 id="steps-title" class="g-h2 max-w-[20ch]">Dari bayar sampai bisa dipakai di bengkel.</h2>
      <ol class="mt-12 grid border-t border-body md:grid-cols-2 lg:grid-cols-4">
        {c.steps.map((step, i) => (
          <li class="flex gap-5 border-b border-line py-6 md:block md:pr-6 lg:border-b-0 lg:border-r lg:py-7 lg:pl-6 lg:first:pl-0 lg:last:border-r-0">
            <span class="g-num w-8 shrink-0 text-5xl text-muted md:block md:w-auto lg:text-7xl" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="g-h3 md:mt-4">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="g-section" aria-labelledby="audience-title">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <h2 id="audience-title" class="g-h2">Kelas ini untuk kamu yang:</h2>
        <ul class="mt-8 space-y-4">
          {c.audience.map((a) => <li class="g-node text-lg leading-snug">{a}</li>)}
        </ul>
        <ul class="mt-10 grid gap-x-8 gap-y-2 border-t border-line pt-6 text-sm text-muted sm:grid-cols-2">
          {c.trust.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="lg:col-span-6">
        <h3 class="g-h3">Kelas dasar: membangun cara periksa yang benar, bukan menggantikan jam terbang.</h3>
        <ul class="mt-6 border-t border-body">
          {c.notFor.map((n) => <li class="border-b border-line py-3.5 leading-relaxed text-muted">{n}</li>)}
        </ul>
        <p class="mt-6 leading-relaxed">
          Tujuannya: kamu tahu <strong>apa yang diperiksa lebih dulu</strong>, <strong>bagaimana membaca hasilnya</strong>,
          dan <strong>kapan sebuah gejala perlu ditangani lebih lanjut</strong> di bengkel.
        </p>
      </div>
    </div>
  </section>

  <section id="harga" class="g-section scroll-mt-10" aria-labelledby="price-title">
    <div class="shell">
      <article class="grid gap-10 border-t-2 border-accent-fill bg-ground-alt p-6 sm:p-9 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <h2 id="price-title" class="g-h2">{c.name}</h2>
          <ul class="mt-8 space-y-4">
            {c.features.map((item) => (
              <li class="g-node">
                <span class="font-semibold">{item.title}</span>
                <span class="mt-0.5 block leading-relaxed text-muted">{item.description}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="lg:col-span-5">
          <p class="text-sm text-muted">Harga normal <span class="line-through">{c.strikePriceDisplay}</span></p>
          <p class="g-num mt-4 border-t border-line pt-5 text-6xl md:text-7xl">{c.priceDisplay}</p>
          <p class="mt-3 text-sm font-semibold text-accent">{c.priceLabel}, hemat {c.savingsDisplay}</p>
          <p class="mt-1 text-sm text-muted">Sekali bayar. Akses selamanya, langsung terbuka setelah pembayaran.</p>
          <a {...checkoutAttrs} data-source-cta="ac_pricing" class="btn btn-primary mt-7 w-full">{checkoutLabel}</a>
          <ClassmateCount slug="kelas-online-ac" count={c.students} variant="talk" class="mt-4" />
          <p class="mt-3 text-sm text-muted">Pembayaran diproses oleh DOKU: QRIS, e-wallet, atau virtual account. Materi terbuka otomatis setelah bayar.</p>
          <p class="mt-6 border-t border-line pt-5 text-sm leading-relaxed text-muted">
            <strong class="text-body">Catatan:</strong> {c.refundNote}
          </p>
        </div>
      </article>
    </div>
  </section>

  <section id="faq" class="g-section scroll-mt-10" aria-labelledby="faq-title">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 id="faq-title" class="g-h2">Pertanyaan yang sering muncul</h2>
        <p class="lead mt-5">Sudah jelas? Pelajari cara periksanya sebelum keluhan AC berikutnya datang.</p>
        <a href="#harga" class="btn btn-ghost mt-7">Lihat harga dan beli</a>
      </div>
      <div class="border-t border-body lg:col-span-8">
        {acFaqs.map((faq) => (
          <details name="faq" class="group border-b border-line">
            <summary class="flex min-h-11 list-none items-start justify-between gap-6 py-5 text-lg font-semibold leading-snug transition-colors hover:text-accent">
              {tidy(faq.question)}
              <svg aria-hidden="true" class="mt-1 h-5 w-5 shrink-0 text-muted transition-transform duration-200 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
            </summary>
            <p class="max-w-prose pb-6 leading-relaxed text-muted">{tidy(faq.answer)}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="g-section" aria-labelledby="closing-title">
    <div class="shell grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-16">
      <h2 id="closing-title" class="g-display lg:col-span-8">{c.tagline}</h2>
      <div class="lg:col-span-4 lg:pb-2">
        <p class="lead">Empat video, satu modul PDF, akses selamanya.</p>
        <a {...checkoutAttrs} data-source-cta="ac_closing" class="btn btn-primary mt-6">{checkoutLabel}</a>
        <p class="mt-3 text-sm text-muted">{c.priceLabel}, harga normal {c.strikePriceDisplay}.</p>
      </div>
    </div>
  </section>
  <SalesPopup productName={c.shortName} product="ac" image="/kelas-ac/thumb-192.webp" />
</BaseLayout>

<script define:vars={{ price: c.price, itemName: c.name }}>
  // GA4 ecommerce shape, so the purchase funnel can be built on standard
  // reports. Payment and Purchase are reported by the checkout page.
  const item = { item_id: 'kelas-online-ac', item_name: itemName, price, quantity: 1 };
  const commerce = { currency: 'IDR', value: price, items: [item] };

  // Inline scripts run before the bundled analytics module defines
  // trackFunnelEvent; module scripts are done by DOMContentLoaded.
  document.addEventListener('DOMContentLoaded', () => window.trackFunnelEvent?.('view_item', commerce));

  // The checkout reads these off its own URL, so carrying them across keeps
  // the ad source attached to the order.
  const attributionParams = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'ttclid', 'fbclid'];

  document.addEventListener('click', (event) => {
    const link = event.target?.closest?.('[data-checkout]');
    if (!link) return;
    const toCheckout = link.hostname === window.location.hostname && link.pathname.startsWith('/checkout');
    if (toCheckout || link.hostname.endsWith('myscalev.com')) {
      const from = new URLSearchParams(window.location.search);
      const to = new URL(link.href);
      for (const key of attributionParams) {
        if (from.has(key) && !to.searchParams.has(key)) to.searchParams.set(key, from.get(key));
      }
      link.href = to.toString();
    }
    window.trackFunnelEvent?.('begin_checkout', { ...commerce, source_cta: link.dataset.sourceCta || 'unknown' });
    window.fbq?.('track', 'InitiateCheckout', { value: price, currency: 'IDR', content_name: itemName, content_ids: [item.item_id], content_type: 'product' });
    // The checkout page sends InitiateCheckout itself unless told this click already did.
    if (toCheckout) {
      try { sessionStorage.setItem('pitcar_checkout_initiated', new URL(link.href).searchParams.get('kelas') || ''); } catch { /* storage blocked */ }
    }
  });
</script>

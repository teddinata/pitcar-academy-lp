---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SeoHead from '../components/SeoHead.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  whatsappNumber?: string;
  gaId?: string;
}

import { whatsappConfig } from "../content.config";
const {
  title,
  description,
  image = '/og-image.png',
  canonical = '/',
  whatsappNumber = whatsappConfig.phoneNumber,
  gaId = 'G-FNT01JRZN7',
} = Astro.props;

const siteUrl = Astro.site || 'https://academy.pitcar.co.id';
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <!-- Google Analytics -->
    <GoogleAnalytics id={gaId} />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <SeoHead
      title={title}
      description={description}
      image={`${siteUrl}${image}`}
      url={`${siteUrl}${canonical}`}
    />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-page text-default antialiased tracking-tight selection:bg-primary/30 selection:text-white">
    <Header whatsappNumber={whatsappNumber} />
    <main id="main-content">
      <slot />
    </main>
    <Footer whatsappNumber={whatsappNumber} />
    <WhatsAppButton number={whatsappNumber} />
  </body>
</html>

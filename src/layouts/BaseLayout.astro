---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SeoHead from '../components/SeoHead.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import FunnelAnalytics from '../components/FunnelAnalytics.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string | URL;
  canonical?: string | URL;
  preloadImage?: string;
  /** Viewports where `preloadImage` is actually the LCP element. */
  preloadImageMedia?: string;
  structuredData?: Record<string, unknown>[];
  gaId?: string;
}

const {
  title,
  description,
  image = '/og-image.jpg',
  canonical = Astro.url.pathname,
  preloadImage,
  preloadImageMedia = '(min-width: 1024px)',
  structuredData = [],
  gaId = import.meta.env.PUBLIC_GA_ID,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <!-- Google Analytics -->
    <GoogleAnalytics id={gaId} />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#080808" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {/* Only fetched where the image is the LCP. On phones the hero image sits
        below the fold and the H1 is the LCP, so a high-priority image preload
        there would compete with the font that heading needs. */}
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" media={preloadImageMedia} />
    )}

    <!-- SEO -->
    <SeoHead
      title={title}
      description={description}
      image={image}
      url={canonical}
      structuredData={structuredData}
    />
  </head>
  <body class="bg-page text-default antialiased tracking-tight selection:bg-primary/30 selection:text-white">
    <FunnelAnalytics />
    <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
